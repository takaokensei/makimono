<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgBase">

    <!-- 1. Content Area (padded start to clear the collapsed 64dp rail) -->
    <LinearLayout
        android:id="@+id/filesContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorBgBase"
        android:orientation="vertical"
        android:paddingStart="@dimen/home_content_margin"
        android:paddingEnd="16dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorBgBase"
            android:elevation="0dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:theme="@style/MenuTheme"
                    app:navigationIcon="@drawable/ic_back_24"
                    app:navigationIconTint="?attr/colorTextPrimary"
                    app:titleTextAppearance="@style/titleTextAppearance"
                    app:titleTextColor="?attr/colorTextPrimary"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/searchContainer"
                    android:layout_width="300dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/crunchyroll_search_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search_24"
                        app:tint="?attr/colorTextSecondary" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter"
                        android:hint="@string/search_files_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="?attr/colorTextPrimary"
                        android:textColorHint="?attr/colorTextSecondary"
                        style="@style/TextAppearance.Makimono.TV.Body" />

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Limpar"
                        android:focusable="true"
                        android:src="@drawable/ic_delete_24"
                        android:visibility="gone"
                        app:tint="?attr/colorTextSecondary"
                        android:padding="8dp" />

                    <ImageView
                        android:id="@+id/btnToggleGrid"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Alternar Lista/Grade"
                        android:focusable="true"
                        android:src="@drawable/ic_grid_view_24"
                        app:tint="?attr/colorAccentPrimary"
                        android:padding="8dp" />

                    <LinearLayout
                        android:id="@+id/containerItemCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_pill_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/cyan_dot_drawable" />

                        <TextView
                            android:id="@+id/tvItemCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:textColor="?attr/colorTextSecondary"
                            style="@style/TextAppearance.Makimono.TV.Caption"
                            android:textStyle="bold"
                            tools:text="25 itens" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/seasonSelectorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvSectionEpisodios"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="Episódios"
                    android:textColor="?attr/colorTextPrimary"
                    style="@style/TextAppearance.Makimono.TV.Headline"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnSeasonSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_season_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tvSelectedSeason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="?attr/colorTextPrimary"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:textStyle="bold"
                        tools:text="Egghead Arc" />

                    <ImageView
                        android:id="@+id/ivSeasonDropdownArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop_down_24"
                        app:tint="?attr/colorAccentPrimary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/tv_overscan_margin"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/tv_overscan_margin"
                android:paddingBottom="@dimen/tv_overscan_margin_vertical" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="24dp"
                android:visibility="invisible"
                tools:visibility="visible" />

            <include
                android:id="@+id/filesSkeleton"
                layout="@layout/component_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/error"
                layout="@layout/error_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <zechs.drive.stream.ui.common.StateView
                android:id="@+id/stateView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. Dark Scrim Overlay when rail expands (70% black) -->
    <View
        android:id="@+id/filesSidebarDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/obsidian_scrim"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="20dp"
        android:translationZ="20dp"
        android:clickable="true"
        android:focusable="false" />

    <!-- 3. Docked Navigation Rail -->
    <LinearLayout
        android:id="@+id/filesNavRail"
        android:layout_width="@dimen/tv_nav_rail_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_sidebar_panel"
        android:descendantFocusability="afterDescendants"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="12dp"
        android:paddingEnd="0dp"
        android:paddingBottom="12dp"
        android:translationZ="24dp">

        <!-- Profile Pill -->
        <LinearLayout
            android:id="@+id/userProfilePill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/user_profile_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusDown="@+id/filesBusca"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="Perfil ativo"
                    android:textColor="@color/obsidian_text_primary"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSwitchProfileSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/nav_switch_profile_subtitle"
                    android:textColor="@color/obsidian_text_secondary"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/swiss_border_specular_subtle" />

        <!-- 1. Buscar -->
        <LinearLayout
            android:id="@+id/filesBusca"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/userProfilePill"
            android:nextFocusDown="@+id/filesHome"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesBuscaIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesBusca"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/search"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Início -->
        <LinearLayout
            android:id="@+id/filesHome"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesBusca"
            android:nextFocusDown="@+id/filesFavorites"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesHomeIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_home_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesHome"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/nav_home"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. Favoritos (Minha lista) -->
        <LinearLayout
            android:id="@+id/filesFavorites"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesHome"
            android:nextFocusDown="@+id/filesHistory"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesFavoritesIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_favorites"
                android:src="@drawable/ic_star_filled_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesFavorites"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/home_my_list"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 4. Histórico -->
        <LinearLayout
            android:id="@+id/filesHistory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesFavorites"
            android:nextFocusDown="@+id/filesDownloads"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesHistoryIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_history"
                android:src="@drawable/ic_history_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesHistory"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/nav_history"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 5. Downloads -->
        <LinearLayout
            android:id="@+id/filesDownloads"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesHistory"
            android:nextFocusDown="@+id/filesCatalog"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesDownloadsIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/downloads_title"
                android:src="@drawable/ic_download_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesDownloads"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/downloads_title"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 6. Catálogo -->
        <LinearLayout
            android:id="@+id/filesCatalog"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesDownloads"
            android:nextFocusDown="@+id/filesFilmes"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesCatalogIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_catalog"
                android:src="@drawable/ic_grid_view_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesCatalog"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/nav_catalog"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 7. Filmes -->
        <LinearLayout
            android:id="@+id/filesFilmes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesCatalog"
            android:nextFocusDown="@+id/filesFolders"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesFilmesIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_movies"
                android:src="@drawable/ic_movie_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesFilmes"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/nav_movies"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 8. Pastas (Active screen) -->
        <LinearLayout
            android:id="@+id/filesFolders"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/nav_item_active_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesFilmes"
            android:nextFocusDown="@+id/filesSettings"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesFoldersIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_folders"
                android:src="@drawable/ic_folder_24"
                app:tint="@color/obsidian_text_primary" />

            <TextView
                android:id="@+id/tvFilesFolders"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/nav_folders"
                android:textColor="@color/obsidian_text_primary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 9. Configurações -->
        <LinearLayout
            android:id="@+id/filesSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_nav_item_height"
            android:layout_marginTop="2dp"
            android:background="@drawable/rail_item_focus_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusUp="@+id/filesFolders"
            android:nextFocusRight="@+id/rvList">

            <ImageView
                android:id="@+id/ivFilesSettingsIcon"
                android:layout_width="@dimen/tv_nav_icon_size"
                android:layout_height="@dimen/tv_nav_icon_size"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_settings_24"
                app:tint="@color/obsidian_text_secondary" />

            <TextView
                android:id="@+id/tvFilesSettings"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:text="@string/nav_settings"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
