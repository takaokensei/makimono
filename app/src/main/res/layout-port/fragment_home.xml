<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_anime_library"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <!-- TOP BAR (Brand + Actions) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnHamburgerMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Abrir menu lateral"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_menu_24"
            app:tint="@color/obsidian_text_primary" />

        <LinearLayout
            android:id="@+id/btnBrandLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/splash_logo" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/obsidian_border_glass" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Anime"
                android:textColor="@color/obsidian_text_primary"
                style="@style/TextAppearance.Makimono.TV.Headline"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter"
                android:text="Library"
                android:textColor="@color/obsidian_accent_primary"
                style="@style/TextAppearance.Makimono.TV.Headline" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Item count -->
        <LinearLayout
            android:id="@+id/containerItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/cyan_dot_drawable" />

            <TextView
                android:id="@+id/tvItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter"
                android:text="0 animes"
                android:textColor="@color/obsidian_text_secondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- SEARCH PILL (Full Width in Portrait) -->
    <LinearLayout
        android:id="@+id/searchPillContainer"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search_24"
            app:tint="@color/obsidian_text_secondary" />

        <EditText
            android:id="@+id/etSearchAnime"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/inter"
            android:hint="Filtrar arquivos ou pastas"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/obsidian_text_primary"
            android:textColorHint="@color/obsidian_text_tertiary"
            style="@style/TextAppearance.Makimono.TV.Callout" />

        <ImageView
            android:id="@+id/btnVoiceSearch"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Pesquisar por voz"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_mic_24"
            app:tint="@color/obsidian_text_secondary" />

        <ImageView
            android:id="@+id/btnClearSearch"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Limpar busca"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_close_24"
            android:visibility="gone"
            app:tint="@color/obsidian_text_secondary"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- HORIZONTAL CHIPS ROW (Tabs for Portrait) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navRail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Início -->
            <LinearLayout
                android:id="@+id/btnNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_24"
                    app:tint="@color/obsidian_accent_secondary" />

                <TextView
                    android:id="@+id/tvNavInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="Início"
                    android:textColor="@color/obsidian_text_secondary"
                    style="@style/TextAppearance.Makimono.TV.Callout" />

            </LinearLayout>

            <!-- 2. Animes (Active by default) -->
            <LinearLayout
                android:id="@+id/btnNavAnimes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/nav_item_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavAnimesIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_24"
                    app:tint="@color/obsidian_text_primary" />

                <TextView
                    android:id="@+id/tvNavAnimes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="Animes"
                    android:textColor="@color/obsidian_text_primary"
                    style="@style/TextAppearance.Makimono.TV.Callout"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 3. Pastas -->
            <LinearLayout
                android:id="@+id/btnNavPastas"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder_24"
                    app:tint="@color/obsidian_accent_secondary" />

                <TextView
                    android:id="@+id/tvNavPastas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="Pastas"
                    android:textColor="@color/obsidian_text_secondary"
                    style="@style/TextAppearance.Makimono.TV.Callout" />

            </LinearLayout>

            <!-- 4. Favoritos -->
            <LinearLayout
                android:id="@+id/btnNavFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavFavoritosIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_filled_24"
                    app:tint="@color/obsidian_accent_secondary" />

                <TextView
                    android:id="@+id/tvNavFavoritos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="Favoritos"
                    android:textColor="@color/obsidian_text_secondary"
                    style="@style/TextAppearance.Makimono.TV.Callout" />

            </LinearLayout>

            <!-- 5. Configurações -->
            <LinearLayout
                android:id="@+id/btnNavConfig"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings_24"
                    app:tint="@color/obsidian_accent_secondary" />

                <TextView
                    android:id="@+id/tvNavConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="Configurações"
                    android:textColor="@color/obsidian_text_secondary"
                    style="@style/TextAppearance.Makimono.TV.Callout" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- MAIN CONTENT: 2-COLUMN GRID IN PORTRAIT -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShelfLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.08"
                    android:text="CONTINUAR ASSISTINDO"
                    android:textColor="@color/obsidian_accent_primary"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContinueWatchingShelf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvQueueShelfLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.08"
                    android:text="MINHA FILA"
                    android:textColor="@color/obsidian_accent_primary"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWatchQueueShelf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible" />

                                <TextView android:id="@+id/tvNewEpisodesShelfLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="8dp" android:fontFamily="@font/inter" android:text="@string/home_new_episodes" android:textColor="@color/obsidian_text_primary" style="@style/TextAppearance.Makimono.TV.Title3" android:textStyle="bold" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvNewEpisodesShelf" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clipChildren="false" android:clipToPadding="false" android:descendantFocusability="afterDescendants" android:focusable="false" android:orientation="horizontal" android:paddingStart="@dimen/home_content_margin" android:paddingEnd="@dimen/home_content_margin" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone" /><TextView
                    android:id="@+id/tvMyListShelfLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/home_my_list"
                    android:textColor="@color/obsidian_text_primary"
                    style="@style/TextAppearance.Makimono.TV.Headline"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStarredShelf"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_shelf_height"
                    android:layout_marginBottom="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvRecentlyAddedShelfLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/home_recently_added"
                    android:textColor="@color/obsidian_text_primary"
                    style="@style/TextAppearance.Makimono.TV.Headline"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentlyAddedShelf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <!-- Main Anime Library Grid (2 columns on phone) -->
                                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGenreFilterChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/home_content_margin"
                    android:paddingEnd="@dimen/home_content_margin"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"
                    tools:visibility="visible" />
<androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAnimeLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorAccentPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

        <zechs.drive.stream.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_24"
                app:tint="?attr/colorTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="Nenhum anime encontrado"
                android:textColor="?attr/colorTextSecondary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
