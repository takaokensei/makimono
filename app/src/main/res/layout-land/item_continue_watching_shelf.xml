<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/cardShelfItem" android:layout_width="@dimen/tv_shelf_card_width" android:layout_height="@dimen/tv_shelf_card_height" android:layout_marginEnd="16dp" android:clickable="true" android:focusable="true" android:foreground="@drawable/item_series_episode_focus_border" app:cardBackgroundColor="@color/obsidian_surface" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeColor="@color/obsidian_border_glass" app:strokeWidth="1dp">
