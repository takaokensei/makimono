<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardEpisodeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/item_series_episode_focus_border"
    app:cardBackgroundColor="@color/obsidian_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#1FFFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- 16:9 Thumbnail on the left -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="168dp"
            android:layout_height="95dp"
            app:cardBackgroundColor="@color/obsidian_bg"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivEpisodeThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/kodi_primary_bg" />

                <!-- Episode number badge overlay (top-left) -->
                <TextView
                    android:id="@+id/tvEpNumberBadge"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="6dp"
                    android:background="#B3070B11"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/obsidian_ice_white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="EP 01" />

                <!-- Watched checkmark badge on top-right (green pill, mockup image 4) -->
                <TextView
                    android:id="@+id/badgeWatched"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/badge_episode_watched"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="@string/series_episode_watched_badge"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Play icon overlay on focus -->
                <ImageView
                    android:id="@+id/ivPlayOverlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_24"
                    android:visibility="gone"
                    app:tint="@color/obsidian_accent"
                    tools:visibility="visible" />

                <!-- Thin progress bar on bottom (accent for in-progress, green for completed) -->
                <ProgressBar
                    android:id="@+id/pbEpisodeProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:max="100"
                    android:progress="40"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:progressTint="@color/obsidian_accent" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Episode Info on the right (matching Mockup Image 4) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/tvEpisodeTitle"
                style="@style/TextAppearance.Makimono.TV.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/obsidian_ice_white"
                tools:text="Episódio 01 - Hitagi Crab, Part One" />

            <!-- Duration row -->
            <TextView
                android:id="@+id/tvEpisodeDuration"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/obsidian_gray"
                android:textSize="12sp"
                tools:text="25 min" />

            <!-- Audio/Subtitle pill badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/glass_meta_pill_bg"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tvAudioBadge"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/obsidian_link_blue_gray"
                    android:textSize="11sp"
                    tools:text="Áudio Japonês • Legenda PT-BR" />
            </LinearLayout>

            <!-- 2-Line Synopsis -->
            <TextView
                android:id="@+id/tvEpisodeSynopsis"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/obsidian_link_blue_gray"
                android:textSize="12sp"
                tools:text="Araragi encontra Hitagi, uma garota que parece ter um problema sobrenatural relacionado a um caranguejo." />

            <!-- Dummy view for tvEpisodeProgressPercent to satisfy binding without showing -->
            <TextView
                android:id="@+id/tvEpisodeProgressPercent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEpisodeDot1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWatchedBadgeLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
