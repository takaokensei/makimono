<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="#030C16">
    <LinearLayout android:id="@+id/filesNavRail" android:layout_width="128dp" android:layout_height="match_parent" android:background="@drawable/bg_sidebar_panel" android:descendantFocusability="afterDescendants" android:elevation="0dp" android:orientation="vertical" android:paddingStart="8dp" android:paddingTop="16dp" android:paddingEnd="8dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/filesBrand" android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/rail_item_focus_bg" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="0dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_makimono_torii" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAKIMONO" android:letterSpacing="0.28" android:textColor="#E3EDFF" android:textSize="10sp" android:layout_marginTop="6dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/filesHome" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/rail_item_focus_bg" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="4dp" android:layout_marginTop="14dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_home_24" app:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/inter" android:text="Início" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/filesCatalog" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/rail_item_focus_bg" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_grid_view_24" app:tint="#7FA3D6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/inter" android:text="Catálogo" android:textColor="#94A3B8" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/filesFolders" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/nav_item_active_bg" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_folder_24" app:tint="#7FA3D6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/inter" android:text="Pastas" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/filesFavorites" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/rail_item_focus_bg" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_star_filled_24" app:tint="#7FA3D6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="@font/inter" android:text="Favoritos" android:textColor="#94A3B8" android:textSize="12sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/filesSettings" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/rail_item_focus_bg" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_settings_24" app:tint="#7FA3D6" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/inter" android:text="Configurações" android:textColor="#94A3B8" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:background="#030C16" android:orientation="vertical" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp">
        <LinearLayout android:id="@+id/appBarLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#030C16" android:elevation="0dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="0dp" android:layout_height="44dp" android:theme="@style/MenuTheme" app:navigationIcon="@drawable/ic_back_24" app:navigationIconTint="?attr/colorTextPrimary" app:titleTextAppearance="@style/titleTextAppearance" app:titleTextColor="?attr/colorTextPrimary" android:layout_weight="1" />
                <LinearLayout android:id="@+id/searchContainer" android:layout_width="300dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:layout_marginEnd="0dp" android:layout_marginBottom="0dp" android:background="@drawable/glass_input_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_search_24" app:tint="?attr/colorTextSecondary" />
                    <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@null" android:fontFamily="@font/inter" android:hint="Pesquisar neste diretório…" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:textColor="?attr/colorTextPrimary" android:textColorHint="?attr/colorTextSecondary" android:textSize="12sp" />
                    <ImageView android:id="@+id/btnClearSearch" android:layout_width="36dp" android:layout_height="36dp" android:background="?selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Limpar" android:focusable="true" android:src="@drawable/ic_delete_24" android:visibility="gone" app:tint="?attr/colorTextSecondary" android:padding="8dp" />
                    <ImageView android:id="@+id/btnToggleGrid" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:background="?selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Alternar Lista/Grade" android:focusable="true" android:src="@drawable/ic_grid_view_24" app:tint="?attr/colorAccentPrimary" android:padding="8dp" />
                    <LinearLayout android:id="@+id/containerItemCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/glass_pill_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="10dp" android:paddingBottom="3dp" android:visibility="gone" tools:visibility="visible">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:background="@drawable/cyan_dot_drawable" />
                        <TextView android:id="@+id/tvItemCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/inter" android:textColor="?attr/colorTextSecondary" android:textSize="11sp" android:textStyle="bold" tools:text="25 itens" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/seasonSelectorRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone" tools:visibility="visible">
                <TextView android:id="@+id/tvSectionEpisodios" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/inter" android:text="Episódios" android:textColor="?attr/colorTextPrimary" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/btnSeasonSelector" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_season_selector" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp">
                    <TextView android:id="@+id/tvSelectedSeason" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/inter" android:textColor="?attr/colorTextPrimary" android:textSize="13sp" android:textStyle="bold" tools:text="Egghead Arc" />
                    <ImageView android:id="@+id/ivSeasonDropdownArrow" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="4dp" android:contentDescription="@null" android:src="@drawable/ic_arrow_drop_down_24" app:tint="?attr/colorAccentPrimary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="@dimen/tv_overscan_margin" android:paddingTop="8dp" android:paddingEnd="@dimen/tv_overscan_margin" android:paddingBottom="@dimen/tv_overscan_margin_vertical" android:padding="0dp" />
            <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:elevation="24dp" android:visibility="invisible" tools:visibility="visible" />
            <include android:id="@+id/error" layout="@layout/error_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>