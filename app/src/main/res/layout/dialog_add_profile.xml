<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="Nome do Perfil"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNewProfileName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/glass_meta_pill_bg"
        android:fontFamily="@font/inter"
        android:hint="Ex: Família, Convidado, etc."
        android:inputType="textPersonName"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter"
        android:text="Escolha um Avatar"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgAvatarChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAvatarCaua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/inter"
            android:text="Guerreiro (Cauã)"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbAvatarAnime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/inter"
            android:text="Espiral Ciano (Anime)"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="13sp" />

    </RadioGroup>

</LinearLayout>