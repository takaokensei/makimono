<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg_base"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHistoryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rail_item_focus_bg"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back_24"
            app:tint="@color/obsidian_text_primary" />

        <TextView
            android:id="@+id/tvHistoryTitle"
            style="@style/TextAppearance.Makimono.TV.Title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="@string/nav_history"
            android:textColor="@color/obsidian_text_primary" />

        <TextView
            android:id="@+id/tvHistoryCount"
            style="@style/TextAppearance.Makimono.TV.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/obsidian_text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/historyFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryAll"
            style="@style/Widget.Makimono.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/history_filter_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryInProgress"
            style="@style/Widget.Makimono.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:text="@string/history_filter_in_progress" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoryCompleted"
            style="@style/Widget.Makimono.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:text="@string/history_filter_completed" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWatchHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvHistoryEmpty"
            style="@style/TextAppearance.Makimono.TV.Subheadline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/history_empty_all"
            android:textColor="@color/obsidian_text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
