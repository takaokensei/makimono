<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stateViewContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_6">

    <ImageView
        android:id="@+id/ivStateIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_folder_24"
        app:tint="?attr/colorTextSecondary" />

    <TextView
        android:id="@+id/tvStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Title3"
        android:textColor="?attr/colorTextPrimary"
        tools:text="Nada por aqui" />

    <TextView
        android:id="@+id/tvStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:maxWidth="360dp"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
        android:textColor="?attr/colorTextSecondary"
        tools:text="Esta pasta não tem vídeos." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStateAction"
        style="@style/Widget.Makimono.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:focusable="true"
        android:visibility="gone"
        tools:text="Escolher pasta"
        tools:visibility="visible" />

</LinearLayout>
