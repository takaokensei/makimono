<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_anime_library"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <!-- TOP HEADER BAR (Replica of files (2).zip header) -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <!-- Logo & App Title -->
        <LinearLayout
            android:id="@+id/btnBrandLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/splash_logo" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#26FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Anime"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter"
                android:text="Library"
                android:textColor="#7DD3FC"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Centered Search Capsule Pill -->
        <LinearLayout
            android:id="@+id/searchPillContainer"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_24"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/etSearchAnime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/inter"
                android:hint="Filtrar arquivos ou pastas"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:clickable="true"
                android:contentDescription="Limpar busca"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_close_24"
                android:visibility="gone"
                app:tint="#94A3B8"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Right Controls: Segmented View Toggle + Item Counter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Segmented View Toggle Pill -->
            <LinearLayout
                android:id="@+id/containerViewToggle"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_segmented_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/btnToggleGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_active"
                    android:clickable="true"
                    android:contentDescription="Modo Grade"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_grid_view_24"
                    app:tint="#FFFFFF" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#1AFFFFFF" />

                <ImageView
                    android:id="@+id/btnToggleList"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:contentDescription="Modo Lista"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_list_view_24"
                    app:tint="#64748B" />

            </LinearLayout>

            <!-- Item Counter with Cyan Dot -->
            <LinearLayout
                android:id="@+id/containerItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cyan_dot_drawable" />

                <TextView
                    android:id="@+id/tvItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter"
                    android:text="0 animes"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="25 animes" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- MAIN WORKSPACE: LEFT FLOATING SIDEBAR + POSTER GRID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Floating Sidebar Navigation Rail -->
        <LinearLayout
            android:id="@+id/navRail"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <!-- 1. Início -->
            <LinearLayout
                android:id="@+id/btnNavInicio"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Início"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 2. Animes (Active by default) -->
            <LinearLayout
                android:id="@+id/btnNavAnimes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/nav_item_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavAnimesIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvNavAnimes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Animes"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 3. Pastas (My Drive & Shared Drives) -->
            <LinearLayout
                android:id="@+id/btnNavPastas"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavPastas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Pastas"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 4. Favoritos -->
            <LinearLayout
                android:id="@+id/btnNavFavoritos"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavFavoritosIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_filled_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavFavoritos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Favoritos"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 5. Configurações -->
            <LinearLayout
                android:id="@+id/btnNavConfig"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Configurações"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bottom Quote Section (From mockup) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="3dp"
                    android:text="Grandes histórias\nnunca acabam."
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#2563EB" />

            </LinearLayout>

        </LinearLayout>

        <!-- Center Main Content: Poster Grid + Continue Watching shelf -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <!-- Optional Top Continue Watching Shelf (Only shown when available) -->
                    <TextView
                        android:id="@+id/tvShelfLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.08"
                        android:text="CONTINUAR ASSISTINDO"
                        android:textColor="#7DD3FC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvContinueWatchingShelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Main Anime Library Grid (5 columns on TV / Landscape) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAnimeLibrary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="false"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="#38BDF8"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Empty State when filter has no results -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search_24"
                    app:tint="#334155" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:text="Nenhum anime encontrado"
                    android:textColor="#64748B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>