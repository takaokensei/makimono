<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_anime_library"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <!-- TOP HEADER BAR (Replica of files (2).zip header) -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Mobile Drawer Hamburger Toggle Button (48dp touch target) -->
        <ImageView
            android:id="@+id/btnHamburgerMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Abrir menu lateral"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_menu_24"
            app:tint="#FFFFFF" />

        <!-- Logo & App Title -->
        <LinearLayout
            android:id="@+id/btnBrandLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/splash_logo" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#26FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.08"
                android:text="MAKIMONO"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter"
                android:text="MEDIA"
                android:textColor="#12A0C7"
                android:textSize="19sp" />

        </LinearLayout>

        <!-- Centered Search Capsule Pill -->
        <LinearLayout
            android:id="@+id/searchPillContainer"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_24"
                app:tint="#94A3B8" />

            <EditText
                android:id="@+id/etSearchAnime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/inter"
                android:hint="Pesquisar na biblioteca"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#F1F5F9"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnVoiceSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Pesquisar por voz"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ic_mic_24"
                app:tint="#94A3B8" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Limpar busca"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close_24"
                android:visibility="gone"
                app:tint="#94A3B8"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Right Controls: Segmented View Toggle + Item Counter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Segmented View Toggle Pill -->
            <LinearLayout
                android:id="@+id/containerViewToggle"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_segmented_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/btnToggleGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_active"
                    android:clickable="true"
                    android:contentDescription="Modo Grade"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_grid_view_24"
                    app:tint="#FFFFFF" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#1AFFFFFF" />

                <ImageView
                    android:id="@+id/btnToggleList"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:contentDescription="Modo Lista"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_list_view_24"
                    app:tint="#64748B" />

            </LinearLayout>

            <!-- Item Counter with Cyan Dot -->
            <LinearLayout
                android:id="@+id/containerItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cyan_dot_drawable" />

                <TextView
                    android:id="@+id/tvItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter"
                    android:text="0 animes"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="25 animes" />

            </LinearLayout>

            <!-- User Profile Indicator Pill (Figma 21:4) -->
            <LinearLayout
                android:id="@+id/userProfilePill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/user_profile_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person_24"
                    app:tint="#22D3EE" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:text="Otaku_Admin"
                    android:textColor="#F1F5F9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- MAIN WORKSPACE: FULL POSTER GRID + PERSISTENT TV NAVIGATION RAIL -->
    <FrameLayout
        android:id="@+id/workspaceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Center Main Content: Poster Grid + Continue Watching shelf -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <!-- FEATURED SPOTLIGHT HERO (Figma 21:4 "EM DESTAQUE") -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/featuredHeroContainer"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="20dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#0F172A"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#2638BDF8"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <!-- Backdrop / Key Art Image -->
                            <ImageView
                                android:id="@+id/ivFeaturedBackdrop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <!-- Bottom-up dark gradient scrim -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="220dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/series_detail_hero_scrim" />

                            <!-- Left-to-right vignette gradient scrim -->
                            <View
                                android:layout_width="540dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/series_detail_vignette" />

                            <!-- Hero Content Block -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="bottom"
                                android:orientation="vertical"
                                android:padding="24dp">

                                <!-- "EM DESTAQUE" Overline -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/cyan_dot_drawable" />

                                    <TextView
                                        android:id="@+id/tvFeaturedOverline"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="@font/inter"
                                        android:letterSpacing="0.12"
                                        android:text="EM DESTAQUE"
                                        android:textColor="#22D3EE"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <!-- Main Title -->
                                <TextView
                                    android:id="@+id/tvFeaturedTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter"
                                    android:maxLines="1"
                                    android:textColor="#F8FAFC"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    tools:text="Classroom of the Elite" />

                                <!-- Japanese Subtitle -->
                                <TextView
                                    android:id="@+id/tvFeaturedJapaneseTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter"
                                    android:maxLines="1"
                                    android:textColor="#94A3B8"
                                    android:textSize="12sp"
                                    tools:text="ようこそ実力至上主義の教室へ" />

                                <!-- Genre Tags Row -->
                                <LinearLayout
                                    android:id="@+id/layoutFeaturedGenres"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal" />

                                <!-- Synopsis Description -->
                                <TextView
                                    android:id="@+id/tvFeaturedSynopsis"
                                    android:layout_width="560dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter"
                                    android:lineSpacingExtra="2dp"
                                    android:maxLines="2"
                                    android:textColor="#CBD5E1"
                                    android:textSize="12sp"
                                    tools:text="Kiyotaka Ayanokōji ingressa na prestigiosa Tokyo Metropolitan Advanced Nurturing High School..." />

                                <!-- CTAs: Assistir Agora + Mais Detalhes -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:id="@+id/btnFeaturedPlay"
                                        android:layout_width="wrap_content"
                                        android:layout_height="40dp"
                                        android:background="@drawable/btn_hero_play_bg"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingStart="18dp"
                                        android:paddingEnd="20dp">

                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_play_24"
                                            app:tint="#0B0E14" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:fontFamily="@font/inter"
                                            android:text="Assistir Agora"
                                            android:textColor="#0B0E14"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/btnFeaturedInfo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="40dp"
                                        android:layout_marginStart="12dp"
                                        android:background="@drawable/btn_secondary_action_bg"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingStart="18dp"
                                        android:paddingEnd="20dp">

                                        <ImageView
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_info_24"
                                            app:tint="#F8FAFC" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:fontFamily="@font/inter"
                                            android:text="Mais Detalhes"
                                            android:textColor="#F8FAFC"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Continue Watching section header (Crunchyroll-style) -->
                    <LinearLayout
                        android:id="@+id/shelfHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvShelfLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.08"
                            android:text="CONTINUAR ASSISTINDO"
                            android:textColor="#7DD3FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShelfViewHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter"
                            android:text="VER HISTÓRICO ›"
                            android:textColor="#22D3EE"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvShelfViewQueue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter"
                            android:text="MINHA FILA ›"
                            android:textColor="#22D3EE"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvContinueWatchingShelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvQueueShelfLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.08"
                        android:text="MINHA FILA"
                        android:textColor="#7DD3FC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWatchQueueShelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Main Anime Library Grid (5 columns on TV / Landscape) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAnimeLibrary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="true"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="#38BDF8"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Empty State when filter has no results -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search_24"
                    app:tint="#334155" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:text="Nenhum anime encontrado"
                    android:textColor="#64748B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Empty State when Home has no continue watching items -->
            <LinearLayout
                android:id="@+id/layoutHomeEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_24"
                    app:tint="#22D3EE" />

                <TextView
                    android:id="@+id/tvEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:text="Nenhum anime em andamento"
                    android:textColor="#F1F5F9"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptySubMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/home_empty_message"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreAnimes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#1E293B"
                    android:fontFamily="@font/inter"
                    android:text="@string/home_explore_animes"
                    android:textColor="#22D3EE"
                    android:textSize="13sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#22D3EE"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#1E293B"
                    android:fontFamily="@font/inter"
                    android:text="Tentar Novamente"
                    android:textColor="#22D3EE"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    app:strokeColor="#22D3EE"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Dim Overlay behind expanded sidebar (giving that dim/blur effect over the animes) -->
        <View
            android:id="@+id/sidebarDimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#66020617"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone" />

        <!-- Left persistent TV navigation rail -->
        <LinearLayout
            android:id="@+id/navRail"
            android:layout_width="@dimen/tv_nav_rail_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_sidebar_panel"
            android:elevation="24dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:translationZ="24dp"
            android:visibility="visible">

            <!-- 1. Início (Active by default) -->
            <LinearLayout
                android:id="@+id/btnNavInicio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_nav_item_height"
                android:background="@drawable/nav_item_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavInicioIcon"
                    android:layout_width="@dimen/tv_nav_icon_size"
                    android:layout_height="@dimen/tv_nav_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvNavInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Início"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 2. Animes -->
            <LinearLayout
                android:id="@+id/btnNavAnimes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_nav_item_height"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavAnimesIcon"
                    android:layout_width="@dimen/tv_nav_icon_size"
                    android:layout_height="@dimen/tv_nav_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavAnimes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/animes"
                    android:textColor="#94A3B8"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- 3. Pastas (My Drive & Shared Drives) -->
            <LinearLayout
                android:id="@+id/btnNavPastas"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_nav_item_height"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="@dimen/tv_nav_icon_size"
                    android:layout_height="@dimen/tv_nav_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavPastas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Pastas"
                    android:textColor="#94A3B8"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- 4. Favoritos -->
            <LinearLayout
                android:id="@+id/btnNavFavoritos"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_nav_item_height"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivNavFavoritosIcon"
                    android:layout_width="@dimen/tv_nav_icon_size"
                    android:layout_height="@dimen/tv_nav_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_filled_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavFavoritos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Favoritos"
                    android:textColor="#94A3B8"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- 5. Configurações -->
            <LinearLayout
                android:id="@+id/btnNavConfig"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_nav_item_height"
                android:layout_marginTop="4dp"
                android:background="@drawable/rail_item_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="@dimen/tv_nav_icon_size"
                    android:layout_height="@dimen/tv_nav_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings_24"
                    app:tint="#7FA3D6" />

                <TextView
                    android:id="@+id/tvNavConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/inter"
                    android:text="Configurações"
                    android:textColor="#94A3B8"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bottom Quote Section (From mockup) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="3dp"
                    android:text="Grandes histórias\nnunca acabam."
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#2563EB" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Mobile Bottom Navigation Bar (Glass effect, thumb-friendly on portrait phone) -->
    <LinearLayout
        android:id="@+id/mobileBottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E0F172A"
        android:backgroundTint="#0F172A"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:translationZ="16dp">

        <!-- Início -->
        <LinearLayout
            android:id="@+id/bottomNavInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBottomNavInicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Início"
                android:src="@drawable/ic_home_24"
                app:tint="#22D3EE" />

            <TextView
                android:id="@+id/tvBottomNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="Início"
                android:textColor="#22D3EE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Animes -->
        <LinearLayout
            android:id="@+id/bottomNavAnimes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBottomNavAnimes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Animes"
                android:src="@drawable/ic_play_24"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvBottomNavAnimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="Animes"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Pastas -->
        <LinearLayout
            android:id="@+id/bottomNavPastas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBottomNavPastas"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Pastas"
                android:src="@drawable/ic_folder_24"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvBottomNavPastas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="Pastas"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Favoritos -->
        <LinearLayout
            android:id="@+id/bottomNavFavoritos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBottomNavFavoritos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Favoritos"
                android:src="@drawable/ic_star_filled_24"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvBottomNavFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="Favoritos"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Configurações -->
        <LinearLayout
            android:id="@+id/bottomNavConfig"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBottomNavConfig"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Configurações"
                android:src="@drawable/ic_settings_24"
