<?xml version="1.0" encoding="utf-8"?>
<!--
    Kodi Estuary "In progress" shelf card: a 16:9 preview photo (Google Drive's
    auto-generated video-frame thumbnail) with a title + progress bar burned
    into a scrim at the bottom, instead of the old icon-only glass card.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardShelfItem"
    android:layout_width="260dp"
    android:layout_height="146dp"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorBgSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/shelf_card_stroke_color"
    app:strokeWidth="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivShelfItemThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/glass_card_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shelf_item_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvShelfItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="#F0F0F0"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Attack on Titan - Episódio 04" />

            <TextView
                android:id="@+id/tvShelfItemProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:textColor="#A0A0A0"
                android:textSize="11sp"
                tools:text="14:20 / 24:00 (59%)" />

            <ProgressBar
                android:id="@+id/pbShelfItemProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="60"
                android:progressTint="#12A0C7" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
