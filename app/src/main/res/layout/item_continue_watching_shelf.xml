<?xml version="1.0" encoding="utf-8"?>
<!--
    Crunchyroll-style "Continue Watching" shelf card:
    - 16:9 thumbnail from Google Drive's auto-generated frame preview
    - Gradient scrim at the bottom for text readability
    - Episode title + "X min restantes" badge
    - Cyan progress bar overlaid at bottom edge
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardShelfItem"
    android:layout_width="@dimen/tv_shelf_card_width"
    android:layout_height="@dimen/tv_shelf_card_height"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorBgSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/shelf_card_stroke_color"
    app:strokeWidth="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Thumbnail: Drive-generated video frame preview -->
        <ImageView
            android:id="@+id/ivShelfItemThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/glass_card_bg" />

        <!-- Bottom scrim gradient for readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shelf_item_scrim" />

        <!-- Top badge row: floating mini play icon + episode pill badge (Figma 21:4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivPlayBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/glass_circle_button_bg"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_play_24"
                app:tint="@color/obsidian_accent_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvEpisodeTopBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tag_genre_pill_bg"
                android:fontFamily="@font/inter"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/obsidian_text_primary"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:textStyle="bold"
                tools:text="T2: Ep. 03" />

        </LinearLayout>

        <!-- Text + badges overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Episode title -->
            <TextView
                android:id="@+id/tvShelfItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="@color/obsidian_text_primary"
                style="@style/TextAppearance.Makimono.TV.Subheadline"
                android:textStyle="bold"
                tools:text="Attack on Titan - Ep. 04" />

            <!-- Episode info + "X min restantes" badge row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShelfItemEpisode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/obsidian_text_secondary"
                    style="@style/TextAppearance.Makimono.TV.Body"
                    tools:text="Ep. 04" />

                <TextView
                    android:id="@+id/tvShelfItemDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text=" • "
                    android:textColor="@color/obsidian_text_tertiary"
                    style="@style/TextAppearance.Makimono.TV.Body" />

                <TextView
                    android:id="@+id/tvShelfItemRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="?attr/colorAccentPrimary"
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:textStyle="bold"
                    tools:text="9 min restantes" />

            </LinearLayout>

        </LinearLayout>

        <!-- Accent progress bar pinned near bottom edge of card with side margin to prevent clipping -->
        <ProgressBar
            android:id="@+id/pbShelfItemProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="60"
            android:progressTint="?attr/colorAccentPrimary"
            android:progressBackgroundTint="@color/obsidian_border_glass"
            tools:progress="40" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
