<?xml version="1.0" encoding="utf-8"?>
<!--
    Crunchyroll-style "Continue Watching" shelf card:
    - 16:9 thumbnail from Google Drive's auto-generated frame preview
    - Gradient scrim at the bottom for text readability
    - Episode title + "X min restantes" badge
    - Cyan progress bar overlaid at bottom edge
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardShelfItem"
    android:layout_width="220dp"
    android:layout_height="124dp"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#2A2A2A"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Thumbnail: Drive-generated video frame preview -->
        <ImageView
            android:id="@+id/ivShelfItemThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/glass_card_bg" />

        <!-- Bottom scrim gradient for readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shelf_item_scrim" />

        <!-- Text + badges overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Episode title -->
            <TextView
                android:id="@+id/tvShelfItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Attack on Titan - Ep. 04" />

            <!-- "X min restantes" badge row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShelfItemRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="#22D3EE"
                    android:textSize="10sp"
                    tools:text="9 min restantes" />

            </LinearLayout>

        </LinearLayout>

        <!-- Cyan progress bar pinned to bottom edge of card -->
        <ProgressBar
            android:id="@+id/pbShelfItemProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="60"
            android:progressTint="#22D3EE"
            android:progressBackgroundTint="#33FFFFFF"
            tools:progress="40" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
