<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <!-- Arc Selection Card (clickable/focusable for D-Pad) -->
    <LinearLayout
        android:id="@+id/tabPillContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:minHeight="56dp"
        android:background="@drawable/bg_arc_card_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- 16:9 Thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="74dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="@color/obsidian_surface"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivArcThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/kodi_primary_bg" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Titles on right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTabTitle"
                style="@style/TextAppearance.Makimono.TV.Callout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/obsidian_text_primary"
                tools:text="Bakemonogatari" />

            <TextView
                android:id="@+id/tvTabSubtitle"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/obsidian_text_secondary"
                tools:text="15 Episódios • 2009" />
        </LinearLayout>

        <!-- Optional icon if needed -->
        <ImageView
            android:id="@+id/ivTabIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:visibility="gone"
            app:tint="@color/obsidian_text_tertiary"
            tools:src="@drawable/ic_play_24" />

    </LinearLayout>

    <!-- Category Chips under the active arc card -->
    <HorizontalScrollView
        android:id="@+id/layoutArcChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/chipsInnerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_category_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/color_chip_text_selector"
                android:textSize="12sp"
                tools:text="Episódios (15)" />

            <TextView
                android:id="@+id/chipSpecials"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_category_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/color_chip_text_selector"
                android:textSize="12sp"
                tools:text="Especiais (3)" />

            <TextView
                android:id="@+id/chipMusic"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_category_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/color_chip_text_selector"
                android:textSize="12sp"
                tools:text="OPs / EDs (6)" />

            <TextView
                android:id="@+id/chipPreviews"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_category_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/color_chip_text_selector"
                android:textSize="12sp"
                tools:text="PVs (2)" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
