<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <EditText android:textColor="#F1F7FF" android:textColorHint="#ACC0D6" android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="Nome do perfil" android:inputType="textPersonName" android:maxLength="32"
            android:singleLine="true" android:background="@drawable/glass_input_bg" android:padding="12dp" />
        <EditText android:textColor="#F1F7FF" android:textColorHint="#ACC0D6" android:id="@+id/avatarUrl" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:hint="URL HTTPS do avatar (opcional)" android:inputType="textUri"
            android:singleLine="true" android:background="@drawable/glass_input_bg" android:padding="12dp" />
        <EditText android:textColor="#F1F7FF" android:textColorHint="#ACC0D6" android:id="@+id/backgroundUrl" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:hint="URL HTTPS do papel de parede (opcional)" android:inputType="textUri"
            android:singleLine="true" android:background="@drawable/glass_input_bg" android:padding="12dp" />
        <CheckBox android:textColor="#F1F7FF" android:buttonTint="#22D3EE" android:id="@+id/isAdmin" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Admin" android:background="@drawable/bg_player_action_vertical" />
        <CheckBox android:textColor="#F1F7FF" android:buttonTint="#22D3EE" android:id="@+id/isKids" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Kids" android:background="@drawable/bg_player_action_vertical" />
        <TextView android:textColor="#ACC0D6" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Admin e Kids identificam o perfil; não ativam bloqueio por PIN nem filtro de conteúdo."
            android:textSize="14sp" android:paddingVertical="8dp" />
        <EditText android:textColor="#F1F7FF" android:textColorHint="#ACC0D6" android:id="@+id/catalogQuery" android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="Buscar anime no catálogo" android:inputType="text" android:singleLine="true"
            android:background="@drawable/glass_input_bg" android:padding="12dp" />
        <Button android:textColor="#22D3EE" android:id="@+id/searchCatalog" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Buscar imagens" android:background="@drawable/bg_player_action_vertical" />
        <TextView android:textColor="#ACC0D6" android:id="@+id/catalogStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:paddingVertical="8dp" android:text="Busque um anime para escolher avatar ou wallpaper." />
        <GridLayout android:id="@+id/catalogImages" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="3" android:clipChildren="false" android:padding="6dp" />
    </LinearLayout>
</ScrollView>
