<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0A0B0E">

    <!-- Left 42%: Full-Height Live Profile Preview (Crunchyroll TV reference) -->
    <FrameLayout
        android:id="@+id/layoutLeftPreview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="42">

        <ImageView
            android:id="@+id/ivPreviewBgA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:src="@drawable/bg_profile_fantasy" />

        <ImageView
            android:id="@+id/ivPreviewBgB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:alpha="0"
            android:src="@drawable/bg_profile_fantasy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreviewAvatarA"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3.5dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreviewAvatarB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:alpha="0"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/white"
                    app:strokeWidth="3.5dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPreviewName"
                style="@style/TextAppearance.Makimono.TV.Title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#D0000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="Taka" />

        </LinearLayout>
    </FrameLayout>

    <!-- Right 58%: Menu & Catalogs Container -->
    <FrameLayout
        android:id="@+id/layoutRightContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="58"
        android:background="#000000"
        android:paddingHorizontal="48dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <!-- Screen 1: Main Menu "Preferências do perfil" -->
        <LinearLayout
            android:id="@+id/panelMainMenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPreferencesTitle"
                style="@style/TextAppearance.Makimono.TV.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp"
                android:text="Preferências do perfil"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- Row 1: Profile Name -->
            <LinearLayout
                android:id="@+id/rowProfileName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_profile_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/tvProfileNameLabel"
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nome do perfil"
                    android:textColor="@color/color_profile_menu_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileNameValue"
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_profile_menu_text"
                    android:textStyle="bold"
                    tools:text="Taka" />
            </LinearLayout>

            <!-- Row 2: Change Avatar -->
            <LinearLayout
                android:id="@+id/btnChangeAvatar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_profile_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mudar Avatar"
                    android:textColor="@color/color_profile_menu_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 3: Change Background -->
            <LinearLayout
                android:id="@+id/btnChangeBackground"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_profile_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mudar Papel de Parede"
                    android:textColor="@color/color_profile_menu_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bottom Row: Delete & DONE Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDeleteProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_delete_profile"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="@string/profile_delete_menu_action"
                    android:textColor="@color/color_btn_delete_profile_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_profile_done_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.08"
                    android:text="CONCLUÍDO"
                    android:textColor="@color/color_profile_done_text"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>

        <!-- Screen 2: Choose an Avatar -->
        <LinearLayout
            android:id="@+id/panelAvatarCatalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAvatarCatalogTitle"
                style="@style/TextAppearance.Makimono.TV.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Escolher um avatar"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutAvatarSkeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <include layout="@layout/component_crunchyroll_skeleton" />
                <include layout="@layout/component_crunchyroll_skeleton" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollAvatarCatalog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/layoutAvatarSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="40dp" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- Screen 3: Choose a Background -->
        <LinearLayout
            android:id="@+id/panelWallpaperCatalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWallpaperCatalogTitle"
                style="@style/TextAppearance.Makimono.TV.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Escolher um papel de parede"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutWallpaperSkeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <include layout="@layout/component_crunchyroll_skeleton" />
                <include layout="@layout/component_crunchyroll_skeleton" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollWallpaperCatalog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/layoutWallpaperSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="40dp" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
