<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <zechs.mpv.MPVView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/controller"
        layout="@layout/player_control_view" />

    <!-- Netflix/Crunchyroll-style Floating Glass Skip Pill (positioned above timeline, safe margins) -->
    <LinearLayout
        android:id="@+id/netflixSkipRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="116dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNetflixSkip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_skip_pill_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/player_skip_intro"
            android:textColor="@color/obsidian_ice_white"
            style="@style/TextAppearance.Makimono.TV.Callout"
            android:textStyle="bold"
            android:elevation="6dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_skip_next_24"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/obsidian_ice_white" />
    </LinearLayout>

    <!-- Next Episode Countdown Card -->
    <include
        android:id="@+id/nextEpisodeCard"
        layout="@layout/view_next_episode_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />

    <!-- Mobile Touch Gestures HUD (Brightness, Volume, Seek, Speed, Ripple) -->
    <include
        android:id="@+id/gestureHud"
        layout="@layout/view_player_gesture_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="28dp" />

</RelativeLayout>
