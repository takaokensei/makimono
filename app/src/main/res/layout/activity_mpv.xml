<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <zechs.mpv.MPVView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/controller"
        layout="@layout/player_control_view" />

    <!-- Netflix-style Auto-Skip Pill for Chapters (Appears automatically without opening controls) -->
    <LinearLayout
        android:id="@+id/netflixSkipRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="36dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNetflixSkip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/glass_pill_accent_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Pular Abertura"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:elevation="6dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_skip_next_24"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="#FFFFFFFF" />
    </LinearLayout>

    <!-- Next Episode Countdown Card -->
    <include
        android:id="@+id/nextEpisodeCard"
        layout="@layout/view_next_episode_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />

</RelativeLayout>