<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btnGenreChip"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_genre_chip_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tvGenreName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:fontFamily="@font/inter"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
        android:textColor="@color/genre_chip_text_selector"
        android:textStyle="bold"
        tools:text="Ação" />

</LinearLayout>
