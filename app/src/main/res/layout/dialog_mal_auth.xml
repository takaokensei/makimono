<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgSurface"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorBgBase"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_unlock_24"
            app:tint="?attr/colorAccentPrimary" />

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Makimono.TV.Title3"
            android:text="Conectar MyAnimeList na TV"
            android:textColor="?attr/colorTextPrimary" />

        <!-- Mode Selectors -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeBrowser"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:text="🌐 Navegador TV"
            android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeQr"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:text="📱 QR Code"
            android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeManual"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:text="⌨️ Código Manual"
            android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <ImageView
            android:id="@+id/btnCloseAuth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Fechar"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_delete_24"
            app:tint="?attr/colorTextSecondary" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBarAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorAccentPrimary"
        app:trackColor="?attr/colorBgGlass" />

    <!-- Container 1: TV Internal Browser Mode (Primary on TV) -->
    <LinearLayout
        android:id="@+id/layoutWebMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Browser Control Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/obsidian_bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Voltar"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="?attr/colorTextSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebReload"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="⟳ Recarregar"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="?attr/colorTextSecondary" />

            <TextView
                android:id="@+id/tvWebHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:text="Faça login no MyAnimeList e autorize a conexão com a TV."
                android:textColor="?attr/colorTextSecondary" />

        </LinearLayout>

        <WebView
            android:id="@+id/webViewAuth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- Container 2: QR Code TV Mode -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutQrMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/obsidian_text_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:strokeColor="?attr/colorAccentPrimary"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/ivMalQrCode"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_player_24" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Instructions -->
            <TextView
                android:id="@+id/tvInstructionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Headline"
                android:text="1. Aponte a câmera do celular para o QR Code"
                android:textColor="?attr/colorTextPrimary" />

            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                android:text="Ou acesse: http://192.168.1.xxx:1420/mal"
                android:textColor="?attr/colorAccentPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmulatorNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:gravity="center"
                android:maxWidth="520dp"
                android:text="💡 No emulador/PC host: Use a aba 'Navegador TV' acima ou acesse http://localhost:1420/mal no computador."
                android:textColor="@color/obsidian_warning"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                android:text="2. Faça login no MyAnimeList pelo celular para conectar a TV"
                android:textColor="?attr/colorTextSecondary"
                android:textStyle="normal" />

            <!-- Status Pill -->
            <LinearLayout
                android:id="@+id/layoutStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_circle_button_bg"
                android:backgroundTint="?attr/colorBgBase"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_circle_button_bg"
                    android:backgroundTint="?attr/colorAccentPrimary" />

                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                    android:text="Aguardando autorização..."
                    android:textColor="?attr/colorTextPrimary" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Container 3: Direct Manual Entry Mode -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutManualMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorBgBase"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="?attr/colorBgGlass"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Headline"
                        android:text="Entrada Manual de Código ou Token"
                        android:textColor="?attr/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                        android:text="Cole aqui o link retornado (ex: http://127.0.0.1:1420/auth/callback?code=...), o código OAuth isolado ou um Access Token do MyAnimeList:"
                        android:textColor="?attr/colorTextSecondary"
                        android:textStyle="normal" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilManualInput"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Código OAuth, URL ou Access Token"
                        app:boxStrokeColor="?attr/colorAccentPrimary"
                        app:hintTextColor="?attr/colorAccentPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManualInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:inputType="textUri|textMultiLine"
                            android:maxLines="3"
                            android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                            android:textColor="?attr/colorTextPrimary" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitManual"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="?attr/colorAccentPrimary"
                        android:text="Validar e Conectar MyAnimeList"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                        android:textColor="@color/obsidian_bg_base"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <TextView
                        android:id="@+id/tvManualError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                        android:textColor="@color/obsidian_danger"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
