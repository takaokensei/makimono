<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_surface_raised"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tvPageErrorMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityLiveRegion="polite"
        android:text="@string/files_page_error_generic"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
        android:textColor="?attr/colorTextPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPageErrorAction"
        style="@style/Widget.Makimono.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:focusable="true"
        android:minHeight="48dp"
        android:text="@string/retry"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
        android:textColor="?attr/colorOnPrimary" />

</LinearLayout>
