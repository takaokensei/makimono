<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.player.PlayerActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_control_view"
        app:show_buffering="when_playing"
        app:show_timeout="4500" />

    <!-- Netflix/Crunchyroll-style Floating Glass Skip Pill (positioned above timeline, safe margins) -->
    <LinearLayout
        android:id="@+id/netflixSkipRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="116dp"
        android:elevation="24dp"
        android:translationZ="24dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNetflixSkip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_skip_pill_selector"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/player_skip_intro"
            android:textColor="#FFFFFF"
            style="@style/TextAppearance.Makimono.TV.Callout"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_skip_next_24"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Next Episode Countdown Card -->
    <include
        android:id="@+id/nextEpisodeCard"
        layout="@layout/view_next_episode_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />

    <!-- Kodi Playback Process Info HUD -->
    <include
        android:id="@+id/kodiInfoHud"
        layout="@layout/view_kodi_info_hud"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/player_technical_hud_top_margin"
        android:layout_marginEnd="16dp"
        android:elevation="30dp"
        android:translationZ="30dp"
        android:visibility="gone" />

    <!-- Mobile Touch Gestures HUD (Brightness, Volume, Seek, Speed, Ripple) -->
    <include
        android:id="@+id/gestureHud"
        layout="@layout/view_player_gesture_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="28dp"
        android:translationZ="28dp" />

</FrameLayout>
