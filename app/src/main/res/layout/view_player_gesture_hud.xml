<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gestureHudRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <!-- Volume HUD Pill (Centered or right-aligned) -->
    <LinearLayout
        android:id="@+id/gestureVolumePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivGestureVolumeIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_volume_up_24"
            app:tint="#FFFFFFFF" />

        <ProgressBar
            android:id="@+id/pbGestureVolume"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="6dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:max="100"
            android:progress="70"
            android:progressTint="?attr/colorAccentPrimary" />

        <TextView
            android:id="@+id/tvGestureVolumeText"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:gravity="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="70%" />
    </LinearLayout>

    <!-- Brightness HUD Pill -->
    <LinearLayout
        android:id="@+id/gestureBrightnessPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivGestureBrightnessIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_brightness_24"
            app:tint="#FFFFFFFF" />

        <ProgressBar
            android:id="@+id/pbGestureBrightness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="6dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:max="100"
            android:progress="55"
            android:progressTint="?attr/colorAccentPrimary" />

        <TextView
            android:id="@+id/tvGestureBrightnessText"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:gravity="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="55%" />
    </LinearLayout>

    <!-- Seek Scrub HUD Card -->
    <LinearLayout
        android:id="@+id/gestureSeekCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvGestureSeekDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="+00:30" />

        <TextView
            android:id="@+id/tvGestureSeekTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="14:20 / 24:00" />
    </LinearLayout>

    <!-- 2x Speed Pill (Press & Hold) -->
    <LinearLayout
        android:id="@+id/gestureSpeedPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/glass_pill_accent_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="2.0x ▶▶"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Left Double Tap Ripple Indicator (<< 10s) -->
    <LinearLayout
        android:id="@+id/doubleTapLeftBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="48dp"
        android:background="@drawable/glass_panel_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_rewind_skip_24"
            app:tint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter"
            android:text="-10s"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Double Tap Ripple Indicator (+10s >>) -->
    <LinearLayout
        android:id="@+id/doubleTapRightBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="48dp"
        android:background="@drawable/glass_panel_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/inter"
            android:text="+10s"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_forward_skip_24"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

</FrameLayout>
