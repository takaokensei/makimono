<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/obsidian_media_scrim"
    app:cardCornerRadius="20dp"
    app:cardElevation="24dp"
    app:strokeColor="?attr/colorBorderGlass"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:background="?attr/colorAccentPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialogTitle"
                    style="@style/TextAppearance.Makimono.TV.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold"
                    tools:text="Central de Legendas Oficiais" />

                <TextView
                    android:id="@+id/tvDialogSubtitle"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/obsidian_text_secondary"
                    android:visibility="gone"
                    tools:text="Verificação Léxica de Idioma • UTF-8 Automático"
                    tools:visibility="visible" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnDialogClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/content_description_close"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/obsidian_text_secondary" />

        </LinearLayout>

        <!-- Apple TV+ Grade Language Selector Pills -->
        <HorizontalScrollView
            android:id="@+id/scrollLanguagePills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/layoutLanguagePills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Optional Action Button (e.g. "✨ Central de Legendas Oficiais") -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogAction"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="?attr/colorBgGlass"
            android:fontFamily="@font/inter"
            android:textColor="?attr/colorAccentPrimary"
            android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="10dp"
            app:strokeColor="?attr/colorBorderGlass"
            app:strokeWidth="1dp"
            tools:text="⚡ Download Rápido • Melhor Oficial (PT-BR)"
            tools:visibility="visible" />

        <!-- Loading indicator for online searches -->
        <ProgressBar
            android:id="@+id/dialogProgressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="?attr/colorAccentPrimary"
            android:visibility="gone" />

        <!-- Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDialogItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_player_glass_menu" />

        <!-- Footer Action Buttons (e.g. Aparência, Sincronia, Tamanho) -->
        <LinearLayout
            android:id="@+id/layoutFooterActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFooterTertiary"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/obsidian_text_secondary"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                android:visibility="gone"
                tools:text="Aparência"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFooterSecondary"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/obsidian_text_secondary"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                tools:text="Sincronia" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFooterPrimary"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter"
                android:textColor="?attr/colorAccentPrimary"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                tools:text="Tamanho" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

