<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#E00B1928"
    app:cardCornerRadius="20dp"
    app:cardElevation="24dp"
    app:strokeColor="?attr/colorBorderGlass"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:background="?attr/colorAccentPrimary" />

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Faixas de Legenda" />

            <ImageView
                android:id="@+id/btnDialogClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_close_24"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- Optional Action Button (e.g. "🔍 Buscar Legendas Online (PT-BR)") -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogAction"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="?attr/colorBgGlass"
            android:fontFamily="@font/inter"
            android:text="🔍 Buscar Legendas Online (PT-BR)"
            android:textColor="?attr/colorAccentPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="10dp"
            app:strokeColor="?attr/colorAccentPrimary"
            app:strokeWidth="1dp"
            tools:visibility="visible" />

        <!-- Loading indicator for online searches -->
        <ProgressBar
            android:id="@+id/dialogProgressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="?attr/colorAccentPrimary"
            android:visibility="gone" />

        <!-- Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDialogItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:maxHeight="320dp"
            android:nestedScrollingEnabled="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/item_player_glass_menu" />

        <!-- Footer Action Buttons (e.g. Tamanho, Sincronia) -->
        <LinearLayout
            android:id="@+id/layoutFooterActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFooterSecondary"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="@font/inter"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="Sincronia" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFooterPrimary"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:textColor="?attr/colorAccentPrimary"
                android:textSize="12sp"
                tools:text="Tamanho" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

