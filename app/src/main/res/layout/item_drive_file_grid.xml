<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGridItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorBgSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/shelf_card_stroke_color"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 16:9 Video / Item Preview Banner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="136dp">

            <!-- Video / Folder Thumbnail Preview -->
            <ImageView
                android:id="@+id/ivGridThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/kodi_primary_bg" />

            <!-- Fallback background when no thumbnail -->
            <View
                android:id="@+id/gridBgFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/home_hero_gradient"
                android:visibility="gone" />

            <!-- Fallback icon (folder / video / subtitle) -->
            <ImageView
                android:id="@+id/ivGridFallbackIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder_24"
                android:visibility="gone"
                app:tint="?attr/colorAccentPrimary" />

            <!-- Bottom scrim gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/shelf_item_scrim" />

            <!-- Type badge (e.g. "VÍDEO", "PASTA", "LEGENDA") -->
            <TextView
                android:id="@+id/tvGridTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/glass_pill_bg"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.06"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="VÍDEO"
                android:textColor="?attr/colorAccentPrimary"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="VÍDEO" />

            <!-- Star button on top-right -->
            <ImageButton
                android:id="@+id/btnGridStar"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/glass_circle_button_bg"
                android:contentDescription="Favoritar"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_star_outline_24"
                app:tint="?attr/colorTextPrimary" />

            <ProgressBar
                android:id="@+id/gridStarLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:visibility="gone" />

            <!-- Center play icon for videos -->
            <ImageView
                android:id="@+id/ivPlayOverlay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:background="@drawable/glass_circle_button_bg"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_play_24"
                android:visibility="gone"
                app:tint="#FFFFFF"
                tools:visibility="visible" />

        </FrameLayout>

        <!-- Details below thumbnail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGridFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="[Erai-raws] Teogonia - 01 [1080p CR WEB-DL AVC AAC].mkv" />

            <TextView
                android:id="@+id/tvGridFileSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="11sp"
                tools:text="1.34 GB" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
