<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGridItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:foreground="@drawable/item_series_episode_focus_border"
    app:cardBackgroundColor="@color/obsidian_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/obsidian_border_glass"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/framePosterContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivGridThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/kodi_primary_bg" />

            <View
                android:id="@+id/gridBgFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/home_hero_gradient"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivGridFallbackIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder_24"
                android:visibility="gone"
                app:tint="?attr/colorAccentPrimary" />

            <TextView
                android:id="@+id/tvGridFolderInitials"
                style="@style/TextAppearance.Makimono.TV.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorTextPrimary"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="JK" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnGridStar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="Favoritar"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="17dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_star_outline_24"
                    app:backgroundTint="@null"
                    app:tint="?attr/colorTextPrimary" />

                <ProgressBar
                    android:id="@+id/gridStarLoading"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnGridFolder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/glass_circle_button_bg"
                    android:contentDescription="Abrir pasta"
                    android:padding="7dp"
                    android:src="@drawable/ic_folder_24"
                    android:visibility="gone"
                    app:tint="@color/obsidian_text_primary" />

            </LinearLayout>

            <!-- Floating Top-Right Cloud / Live Progress Pill -->
            <TextView
                android:id="@+id/tvGridCloudPill"
                style="@style/TextAppearance.Makimono.TV.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_seedbox_cloud_pill"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:textColor="@color/obsidian_accent_cyan"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="NUVEM"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/ivPlayOverlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:alpha="0.9"
                android:background="@drawable/glass_circle_button_bg"
                android:contentDescription="Reproduzir"
                android:padding="10dp"
                android:src="@drawable/ic_play_24"
                android:visibility="gone"
                app:tint="@color/obsidian_text_primary"
                tools:visibility="visible" />

            <!-- Fine 3dp Cyan Progress Bar at the bottom of the poster -->
            <ProgressBar
                android:id="@+id/progressGridDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:progressDrawable="@drawable/bg_fast_start_progress"
                android:visibility="gone"
                tools:progress="48"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/gridCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/obsidian_surface"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="9dp"
            android:paddingEnd="11dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/framePosterContainer">

            <TextView
                android:id="@+id/tvGridFileName"
                style="@style/TextAppearance.Makimono.TV.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:hyphenationFrequency="none"
                android:letterSpacing="-0.01"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="@color/obsidian_text_primary"
                android:textStyle="bold"
                tools:text="Jujutsu Kaisen" />

            <LinearLayout
                android:id="@+id/layoutGridBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGridResBadge"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_pill_bg"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="1080P"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvGridCodecBadge"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/glass_pill_bg"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:textColor="@color/obsidian_text_secondary"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="HEVC"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvGridFileSize"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/glass_pill_bg"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:textColor="@color/obsidian_text_secondary"
                    android:textStyle="bold"
                    tools:text="24 EP" />

                <TextView
                    android:id="@+id/tvGridTypeBadge"
                    style="@style/TextAppearance.Makimono.TV.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/glass_pill_bg"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:textColor="@color/obsidian_text_secondary"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="PASTA" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
