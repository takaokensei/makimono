<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg_base"
    tools:context=".ui.main.MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mainNavHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Modo Madrugada: OLED Eye-Comfort Anti-Glare Veil -->
    <View
        android:id="@+id/nocturnalOledVeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/obsidian_bg_base"
        android:alpha="0.0"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Ambient Soundscape Whisper Indicator (Overscan protected 48dp/27dp) -->
    <LinearLayout
        android:id="@+id/ambientWhisperPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="27dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_surface_overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:alpha="0.0"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no">

        <TextView
            android:id="@+id/tvAmbientTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/obsidian_text_secondary"
            android:textSize="12sp"
            tools:text="♪ Solitude — Ryuichi Sakamoto" />
    </LinearLayout>

    <!-- Vinheta Splash Video Overlay (Netflix-style intro on cold start) -->
    <FrameLayout
        android:id="@+id/vinhetaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/obsidian_bg_base"
        android:clickable="true"
        android:elevation="999dp"
        android:focusable="true"
        android:translationZ="999dp"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/pvVinheta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Sutil preload indicator matching Apple / Netflix standard -->
        <LinearLayout
            android:id="@+id/vinhetaPreloadIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:alpha="0.85">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="?attr/colorAccentPrimary" />

            <TextView
                android:id="@+id/tvVinhetaPreloadStatus"
                style="@style/TextAppearance.Makimono.TV.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/startup_preparing_library"
                android:textColor="@color/obsidian_text_secondary" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
