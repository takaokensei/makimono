<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    tools:context=".ui.main.MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mainNavHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Vinheta Splash Video Overlay (Netflix-style intro on cold start) -->
    <FrameLayout
        android:id="@+id/vinhetaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:elevation="999dp"
        android:focusable="true"
        android:translationZ="999dp"
        android:visibility="gone">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/pvVinheta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipVinheta"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="28dp"
            android:backgroundTint="#4D000000"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.06"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="PULAR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_forward_skip_24"
            app:iconGravity="textEnd"
            app:iconSize="16dp"
            app:iconTint="#FFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp" />

    </FrameLayout>

</FrameLayout>