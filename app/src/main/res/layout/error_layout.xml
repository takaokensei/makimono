<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical">

    <TextView
        android:id="@+id/error_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_margin="8dp"
        android:drawablePadding="8dp"
        android:fontFamily="@font/inter"
        android:text="@string/something_went_wrong"
        android:textAlignment="center"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="16sp"
        app:drawableTint="?attr/colorAccentPrimary"
        app:drawableTopCompat="@drawable/ic_error_72" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnectDrive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter"
        android:text="@string/connect_google_drive"
        android:textColor="?attr/colorBgBase"
        android:visibility="gone"
        app:backgroundTint="?attr/colorAccentPrimary"
        app:cornerRadius="8dp"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter"
        android:text="@string/retry"
        android:textColor="?attr/colorTextPrimary"
        app:strokeColor="?attr/colorTextSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
