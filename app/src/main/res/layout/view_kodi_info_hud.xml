<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hudCard"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#CC141622"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info_24"
                app:tint="?attr/colorAccentPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="KODI MEDIA INFO"
                android:textColor="?attr/colorAccentPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="[INFO]"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#22FFFFFF" />

        <!-- Video Info Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="VÍDEO"
            android:textColor="?attr/colorAccentSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudVideoCodec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="HEVC (H.265) • HW MediaCodec" />

        <TextView
            android:id="@+id/tvHudVideoResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="12sp"
            tools:text="1920x1080 @ 23.976 fps" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#22FFFFFF" />

        <!-- Audio Info Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="ÁUDIO"
            android:textColor="?attr/colorAccentSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudAudioInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="AAC • 2.0 Estéreo (48.0 kHz)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#22FFFFFF" />

        <!-- Subtitle Info Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="LEGENDA"
            android:textColor="?attr/colorAccentSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudSubtitleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="★ [Drive] Português (BR) (SRT)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#22FFFFFF" />

        <!-- Buffer / Health Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="BUFFER / CACHE"
                android:textColor="?attr/colorAccentSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHudBufferBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="#4CAF50"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🟢 Saudável" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHudBufferDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="28.4s adiantados em RAM" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
