<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNextEpisodeRoot"
    android:layout_width="390dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:elevation="24dp"
    android:focusable="false"
    android:translationZ="24dp"
    app:cardBackgroundColor="#F20E131E"
    app:cardCornerRadius="16dp"
    app:cardElevation="20dp"
    app:strokeColor="?attr/colorBorderGlass"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- 16:9 Thumbnail Preview with Play Icon Overlay -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="68dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#2FFFFFFF"
                app:strokeWidth="0.8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivNextEpisodeThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kodi_primary_bg" />

                    <!-- Scrim for contrast -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33000000" />

                    <!-- Play Glyph Badge -->
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_circle_button_bg"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_play_24"
                        app:tint="#FFFFFFFF" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Right Side: Info & Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Header: Countdown Kicker + Close Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNextEpisodeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.06"
                        android:text="A SEGUIR • 10s"
                        android:textColor="?attr/colorAccentPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnCancelNextEpisode"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/glass_circle_button_bg"
                        android:clickable="true"
                        android:contentDescription="Cancelar"
                        android:focusable="true"
                        android:nextFocusDown="@+id/btnPlayNextEpisodeNow"
                        android:padding="8dp"
                        android:src="@drawable/ic_close_24"
                        app:tint="#FFFFFFFF" />
                </LinearLayout>

                <!-- Clean Episode Title -->
                <TextView
                    android:id="@+id/tvNextEpisodeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="Tensei Shitara Slime Datta Ken • Ep. 04" />

                <!-- Primary Action Button: High contrast Pill -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayNextEpisodeNow"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:background="@drawable/glass_pill_accent_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusedByDefault="true"
                    android:nextFocusUp="@+id/btnCancelNextEpisode"
                    android:fontFamily="@font/inter"
                    android:paddingStart="14dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="0dp"
                    android:text="Assistir Agora"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_play_24"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="14dp"
                    app:iconTint="#FFFFFFFF" />

            </LinearLayout>
        </LinearLayout>

        <!-- Smooth bottom countdown progress indicator -->
        <ProgressBar
            android:id="@+id/pbNextEpisodeCountdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:background="#20FFFFFF"
            android:max="100"
            android:progress="100"
            android:progressTint="?attr/colorAccentPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
