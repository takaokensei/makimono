<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library_root_picker_title"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Title2"
        android:textColor="?attr/colorTextPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFolderParent"
            style="@style/Widget.Makimono.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/library_root_go_parent"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/library_root_go_parent_short" />

        <TextView
            android:id="@+id/tvFolderBreadcrumbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="@string/my_drive"
            android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
            android:textColor="?attr/colorTextSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPickerCurrentSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="?attr/colorTextSecondary"
        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFolderPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp"
            android:descendantFocusability="afterDescendants" />

        <zechs.drive.stream.ui.common.StateView
            android:id="@+id/stateFolderPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressFolderPicker"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickerLoadMore"
        style="@style/Widget.Makimono.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/library_root_load_more"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickerCancel"
            style="@style/Widget.Makimono.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/library_root_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickerSelect"
            style="@style/Widget.Makimono.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/library_root_select_current" />
    </LinearLayout>

</LinearLayout>
