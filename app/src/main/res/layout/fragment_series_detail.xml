<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <!-- 1. Apple TV Directional Ambient Hero Backdrop Image -->
        <ImageView
            android:id="@+id/ivHeroBackdrop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="1.0"
            android:contentDescription="@null"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@id/tabsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/bg_anime_library" />

        <View
            android:id="@+id/viewDynamicColorTint"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivHeroBackdrop" />

        <!-- Directional Scrim 1: Horizontal gradient (95% at left -> 0% at 55% width) -->
        <View
            android:id="@+id/viewHeroScrimHorizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/scrim_hero_backdrop_horizontal"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivHeroBackdrop"
            app:layout_constraintWidth_percent="0.55" />

        <!-- Directional Scrim 2: Vertical gradient (0% at top 50% -> 100% solid at bottom) -->
        <View
            android:id="@+id/viewHeroScrimVertical"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/scrim_hero_backdrop_vertical"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivHeroBackdrop" />

        <!-- Solid Base Surface under hero tabs and episode area -->
        <View
            android:id="@+id/viewSeriesBodySurface"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/colorBgBase"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer" />

        <!-- 4. Top Header Bar -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="28dp"
            android:paddingEnd="40dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_secondary_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_back_24"
                    app:tint="@color/btn_secondary_action_foreground" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Breadcrumbs: Animes › Séries -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBreadcrumbRoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:text="@string/series_breadcrumb_library"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                    android:textColor="@color/obsidian_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="//"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                    android:textColor="@color/obsidian_text_tertiary" />

                <TextView
                    android:id="@+id/tvBreadcrumbCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.06"
                    android:text="@string/series_breadcrumb_titles"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                    android:textColor="@color/obsidian_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- Search Button -->
            <FrameLayout
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_secondary_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/search"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_search_24"
                    app:tint="@color/btn_secondary_action_foreground" />
            </FrameLayout>

        </LinearLayout>

        <!-- 5. Hero Card Variant Container (Sharp 2:3 Poster Card on Left + Content on Right) -->
        <LinearLayout
            android:id="@+id/heroContentBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topHeaderBar">

            <!-- Hero Poster Card (Sharp 2:3 Portrait Poster) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeriesPoster"
                android:layout_width="190dp"
                android:layout_height="285dp"
                android:clickable="false"
                android:focusable="false"
                app:cardBackgroundColor="?attr/colorBgSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/obsidian_focus_fill"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/ivSeriesPosterCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/kodi_primary_bg" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Text Details & Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- Japanese Kanji Title -->
            <TextView
                android:id="@+id/tvJapaneseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:shadowColor="@color/obsidian_scrim"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Title2"
                android:textColor="@color/surface_specular"
                android:visibility="gone"
                tools:text="グリザイアの楽園"
                tools:visibility="visible" />

            <!-- Main Romaji / Canonical Title -->
            <TextView
                android:id="@+id/tvRomajiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:shadowColor="@color/obsidian_media_scrim"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Display"
                android:textColor="@color/obsidian_text_primary"
                tools:text="Grisaia no Rakuen" />

            <!-- Canonical Franchise Pill (e.g. Franquia Canônica • 13 Obras Disponíveis) -->
            <TextView
                android:id="@+id/tvFranchiseCanonicalPill"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_meta_pill_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/obsidian_accent"
                android:visibility="gone"
                tools:text="Franquia Canônica • 13 Obras Disponíveis"
                tools:visibility="visible" />

            <!-- Subtitle / English Title -->
            <TextView
                android:visibility="gone"
            android:id="@+id/tvEnglishSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="?attr/colorAccentPrimary"
                tools:text="THE EDEN OF GRISAIA" />

            <!-- Meta Row 1: Age Rating | Year | Status | MAL Rating -->
            <LinearLayout
                android:id="@+id/metaRow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAgeRating"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_age_rating_bg"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    tools:text="16+" />

                <TextView
                    android:id="@+id/tvReleaseYear"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/obsidian_text_secondary"
                    tools:text="2015" />

                <TextView
                    android:layout_marginStart="8dp"
            android:visibility="gone"
            android:id="@+id/tvSeriesStatus"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/obsidian_text_secondary"
                    tools:text="Completo" />

                <!-- Rating pill -->
                <LinearLayout
                    android:layout_marginStart="10dp"
            android:visibility="gone"
            android:id="@+id/layoutRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_filled_24"
                        app:tint="@color/obsidian_warning" />

                    <TextView
                        android:id="@+id/tvMalScore"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/obsidian_text_primary"
                        tools:text="8.2" />

                    <TextView
                        android:id="@+id/tvRatingSource"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/obsidian_text_secondary"
                        android:text="@string/series_source_mal" />
                </LinearLayout>

            </LinearLayout>

            <!-- Meta Row 2: Tech Specs (1080p, Dual Audio, Multi Subs) -->
            <LinearLayout
                android:id="@+id/metaRow2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1080p -->
                <LinearLayout
                    android:id="@+id/qualityBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_player_24"
                        app:tint="@color/obsidian_text_secondary" />

                    <TextView
                        android:id="@+id/tvQualityBadge"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <!-- Dual Áudio -->
                <LinearLayout
                    android:id="@+id/audioBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_audio_24"
                        app:tint="@color/obsidian_text_secondary" />

                    <TextView
                        android:id="@+id/tvAudioTrackBadge"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <!-- Multi Subs -->
                <LinearLayout
                    android:id="@+id/subtitleBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_subtitles_24"
                        app:tint="@color/obsidian_text_secondary" />

                    <TextView
                        android:id="@+id/tvSubtitleBadge"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvGenres"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/obsidian_text_secondary"
                android:visibility="gone"
                tools:text="Ação • Aventura • Ficção Científica"
                tools:visibility="visible" />

            <!-- Synopsis -->
            <TextView
                android:id="@+id/tvSynopsis"
                style="@style/TextAppearance.Makimono.TV.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/obsidian_text_secondary"
                tools:text="Após ser atacada por um vampiro e sobreviver, Koyomi Araragi se vê envolvido com diversas garotas ligadas a excentricidades sobrenaturais..." />

            <TextView
                android:id="@+id/tvSynopsisMore"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:clickable="true"
                android:contentDescription="@string/series_synopsis_expand"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:text="@string/series_synopsis_expand"
                android:textColor="@color/obsidian_link_blue_gray"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Actions Row: Continue Watch / Play | Trailer | Favorite | Watched -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary Action Button (Play / Continue) -->
                <LinearLayout
                    android:id="@+id/btnPrimaryAction"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/detail_primary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/ivPrimaryActionIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_play_24"
                        app:tint="@color/detail_primary_action_foreground" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="@string/series_action_play"
            android:textStyle="bold"
            android:id="@+id/tvPrimaryActionTitle"
                            style="@style/TextAppearance.Makimono.TV.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/detail_primary_action_foreground"
                            tools:text="Continuar Assistindo" />

                        <TextView
                            android:maxLines="1"
            android:id="@+id/tvPrimaryActionSubtitle"
                            style="@style/TextAppearance.Makimono.TV.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/detail_primary_action_foreground"
                            tools:text="Ep. 4 • 14:28 restante" />

                    </LinearLayout>
                </LinearLayout>

            <!-- Ver Trailer -->
                <LinearLayout
                    android:id="@+id/btnTrailer"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_trailer_24"
                        app:tint="@color/btn_secondary_action_foreground" />

                    <TextView
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_trailer"
                        android:textColor="@color/btn_secondary_action_foreground" />
                </LinearLayout>

                <!-- Favoritar -->
                <LinearLayout
                    android:id="@+id/btnFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivFavoriteIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_star_outline_24"
                        app:tint="@color/btn_secondary_action_foreground" />

                    <TextView
                        android:id="@+id/tvFavoriteText"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_favorite"
                        android:textColor="@color/btn_secondary_action_foreground" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMoreActions"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_more_actions_circle"
                    android:contentDescription="@string/series_more_actions"
                    android:padding="13dp"
                    android:src="@drawable/ic_more_vert_24"
                    app:tint="@color/btn_secondary_action_foreground"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <!-- Seguir pasta e receber alertas de episódios -->
                <LinearLayout
                    android:id="@+id/btnFollow"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivFollowIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_notification_24"
                        app:tint="@color/btn_secondary_action_foreground" />

                    <TextView
                        android:id="@+id/tvFollowText"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_follow"
                        android:textColor="@color/btn_secondary_action_foreground" />
                </LinearLayout>

                <!-- Marcar como Assistido -->
                <LinearLayout
                    android:id="@+id/btnMarkWatched"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivMarkWatchedIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_check_24"
                        app:tint="@color/btn_secondary_action_foreground" />

                    <TextView
                        android:id="@+id/tvMarkWatchedText"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_mark_watched_short"
                        android:textColor="@color/btn_secondary_action_foreground" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

        <!-- 4. Navigation Tabs: [EPISÓDIOS] | [DETALHES] | [MAIS COMO ESTE] (Image 4) -->
        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroContentBlock">

            <TextView
                android:id="@+id/tabButtonEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/tab_nav_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/tab_episodes"
                android:textColor="@color/tab_nav_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabButtonDetails"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tab_nav_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/tab_details"
                android:textColor="@color/tab_nav_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabButtonMoreLikeThis"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tab_nav_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/tab_more_like_this"
                android:textColor="@color/tab_nav_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 5. TAB 1: Panel Episodes - 2-Column Split Layout (Image 5) -->
        <LinearLayout
            android:id="@+id/panelEpisodesTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer">

            <!-- Left Column: Seasons / Franchise Arcs (Vertical list) -->
            <LinearLayout
                android:id="@+id/layoutSeasonsColumn"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEpisodesHeading"
                    style="@style/TextAppearance.Makimono.TV.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/series_heading_episodes"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeasonTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_series_season_tab" />

            </LinearLayout>

            <!-- Right Column: Episodes (Horizontal Carousel) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPartialListingNotice"
                    style="@style/TextAppearance.Makimono.TV.Callout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/series_partial_listing_notice"
                    android:textColor="@color/obsidian_text_secondary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_series_episode_card" />

                <TextView
                    android:id="@+id/tvEmptyEpisodes"
                    style="@style/TextAppearance.Makimono.TV.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/series_empty_category"
                    android:textColor="@color/obsidian_text_secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- 6. TAB 2: Panel Details -->
        <LinearLayout
            android:id="@+id/panelDetailsTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer">

            <TextView
                style="@style/TextAppearance.Makimono.TV.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_details"
                android:textColor="@color/obsidian_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailsFullSynopsis"
                style="@style/TextAppearance.Makimono.TV.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/obsidian_text_secondary"
                tools:text="Full detailed synopsis about this anime and characters..." />

        </LinearLayout>

        <!-- 7. TAB 3: Panel More Like This -->
        <LinearLayout
            android:id="@+id/panelMoreLikeThisTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer">

            <TextView
                style="@style/TextAppearance.Makimono.TV.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_more_like_this"
                android:textColor="@color/obsidian_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMoreLikeThisNotice"
                style="@style/TextAppearance.Makimono.TV.Callout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Explore as outras obras e temporadas da franquia na coluna lateral de Episódios."
                android:textColor="@color/obsidian_text_secondary" />

        </LinearLayout>

        <!-- Loading / Skeletons / StateView -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorAccentPrimary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone" />

        <include
            android:id="@+id/seriesSkeleton"
            layout="@layout/component_skeleton_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer" />

        <zechs.drive.stream.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/series_retry"
            android:textColor="?attr/colorTextPrimary"
            android:visibility="gone"
            app:backgroundTint="?attr/colorBgSurface"
            app:cornerRadius="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stateView"
            app:strokeColor="?attr/colorAccentPrimary"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
