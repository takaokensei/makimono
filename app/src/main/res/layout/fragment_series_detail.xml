<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <!-- 1. Hero Backdrop Image (Subtle ambient layer) -->
        <ImageView
            android:id="@+id/ivHeroBackdrop" android:cropToPadding="true"
            android:layout_width="0dp"
            android:layout_height="480dp"
            android:alpha="0.22"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/bg_anime_library" />

        <!-- Dynamic Tint Gradient Overlay for coverImage.color -->
        <View
            android:id="@+id/viewDynamicColorTint"
            android:layout_width="0dp"
            android:layout_height="480dp"
            android:background="@drawable/series_detail_hero_scrim"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 2. Bottom Scrim Gradient (Transparent -> @color/obsidian_bg_base) -->
        <View
            android:id="@+id/viewHeroScrim"
            android:layout_width="0dp"
            android:layout_height="320dp"
            android:background="@drawable/series_detail_hero_scrim"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 3. Left Vignette Gradient (@color/obsidian_bg_surface -> Transparent) -->
        <View
            android:id="@+id/viewHeroVignette"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/series_detail_vignette"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Keep the scrolling episode area opaque so the hero artwork never bleeds
             through season tabs or episode cards. The existing hero scrim softens
             the transition immediately above this surface. -->
        <View
            android:id="@+id/viewSeriesBodySurface"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/obsidian_bg_base"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroContentBlock" />

        <!-- 4. Top Header Bar -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="28dp"
            android:paddingEnd="40dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_secondary_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_back_24"
                    app:tint="@color/obsidian_text_primary" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Breadcrumbs: Animes › Séries -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBreadcrumbRoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/series_breadcrumb_library"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                    android:textColor="@color/obsidian_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="›"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                    android:textColor="@color/obsidian_text_tertiary" />

                <TextView
                    android:id="@+id/tvBreadcrumbCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/series_breadcrumb_titles"
                    android:textAppearance="@style/TextAppearance.Makimono.TV.Callout"
                    android:textColor="@color/obsidian_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- Search Button -->
            <FrameLayout
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_secondary_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search_24"
                    app:tint="@color/obsidian_text_primary" />
            </FrameLayout>

        </LinearLayout>

        <!-- 5. Hero Card Variant Container (Sharp 2:3 Poster Card on Left + Content on Right) -->
        <LinearLayout
            android:id="@+id/heroContentBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topHeaderBar">

            <!-- Hero Poster Card (Sharp 2:3 Portrait Poster) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeriesPoster"
                android:layout_width="190dp"
                android:layout_height="285dp"
                android:clickable="false"
                android:focusable="false"
                app:cardBackgroundColor="@color/obsidian_bg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/obsidian_focus_fill"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/ivSeriesPosterCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/kodi_primary_bg" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Text Details & Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- Japanese Kanji Title -->
            <TextView
                android:id="@+id/tvJapaneseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:shadowColor="@color/obsidian_scrim"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Title2"
                android:textColor="@color/surface_specular"
                android:visibility="gone"
                tools:text="グリザイアの楽園"
                tools:visibility="visible" />

            <!-- Main Romaji / Canonical Title -->
            <TextView
                android:id="@+id/tvRomajiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:shadowColor="@color/obsidian_media_scrim"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Display"
                android:textColor="@color/obsidian_text_primary"
                tools:text="Grisaia no Rakuen" />

            <!-- Subtitle / English Title -->
            <TextView
                android:visibility="gone"
            android:id="@+id/tvEnglishSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="@color/obsidian_accent_primary"
                tools:text="THE EDEN OF GRISAIA" />

            <!-- Meta Row 1: Age Rating | Year | Status | MAL Rating -->
            <LinearLayout
                android:id="@+id/metaRow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAgeRating"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_age_rating_bg"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold"
                    tools:text="16+" />

                <TextView
                    android:id="@+id/tvReleaseYear"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/obsidian_text_secondary"
                    tools:text="2015" />

                <TextView
                    android:layout_marginStart="8dp"
            android:visibility="gone"
            android:id="@+id/tvSeriesStatus"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/obsidian_text_secondary"
                    tools:text="Completo" />

                <!-- Rating pill -->
                <LinearLayout
                    android:layout_marginStart="10dp"
            android:visibility="gone"
            android:id="@+id/layoutRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_filled_24"
                        app:tint="@color/obsidian_warning" />

                    <TextView
                        android:id="@+id/tvMalScore"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/obsidian_text_primary"
                        tools:text="8.2" />

                    <TextView
                        android:id="@+id/tvRatingSource"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/obsidian_text_secondary"
                        android:text="@string/series_source_mal" />
                </LinearLayout>

            </LinearLayout>

            <!-- Meta Row 2: Tech Specs (1080p, Dual Audio, Multi Subs) -->
            <LinearLayout
                android:id="@+id/metaRow2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1080p -->
                <LinearLayout
                    android:id="@+id/qualityBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_player_24"
                        app:tint="@color/obsidian_text_secondary" />

                    <TextView
                        android:id="@+id/tvQualityBadge"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <!-- Dual Áudio -->
                <LinearLayout
                    android:id="@+id/audioBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_audio_24"
                        app:tint="@color/obsidian_text_secondary" />

                    <TextView
                        android:id="@+id/tvAudioTrackBadge"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <!-- Multi Subs -->
                <LinearLayout
                    android:id="@+id/subtitleBadgeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_subtitles_24"
                        app:tint="@color/obsidian_text_secondary" />

                    <TextView
                        android:id="@+id/tvSubtitleBadge"
                        style="@style/TextAppearance.Makimono.TV.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvGenres"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/obsidian_text_secondary"
                android:visibility="gone"
                tools:text="Ação • Aventura • Ficção Científica"
                tools:visibility="visible" />

            <!-- Synopsis -->
            <TextView
                android:id="@+id/tvSynopsis"
                style="@style/TextAppearance.Makimono.TV.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/obsidian_text_secondary"
                tools:text="Após ser atacada por um vampiro e sobreviver, Koyomi Araragi se vê envolvido com diversas garotas ligadas a excentricidades sobrenaturais..." />

            <TextView
                android:id="@+id/tvSynopsisMore"
                style="@style/TextAppearance.Makimono.TV.Caption"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="@string/series_synopsis_expand"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minWidth="104dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/series_synopsis_expand"
                android:textColor="@color/obsidian_accent_primary"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Actions Row: Continue Watch / Play | Trailer | Favorite | Watched -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary Action Button (Play / Continue) -->
                <LinearLayout
                    android:id="@+id/btnPrimaryAction"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/detail_primary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/ivPrimaryActionIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_play_24"
                        app:tint="@color/detail_primary_action_foreground" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:duplicateParentState="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="@string/series_action_play"
            android:textStyle="bold"
            android:id="@+id/tvPrimaryActionTitle"
                            style="@style/TextAppearance.Makimono.TV.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif-bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/detail_primary_action_foreground"
                            tools:text="Continuar Assistindo" />

                        <TextView
                            android:maxLines="1"
            android:id="@+id/tvPrimaryActionSubtitle"
                            style="@style/TextAppearance.Makimono.TV.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/detail_primary_action_foreground"
                            tools:text="Ep. 4 • 14:28 restante" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Ver Trailer -->
                <LinearLayout
                    android:id="@+id/btnTrailer"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trailer_24"
                        app:tint="@color/obsidian_text_primary" />

                    <TextView
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_trailer"
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <!-- Favoritar -->
                <LinearLayout
                    android:id="@+id/btnFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivFavoriteIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline_24"
                        app:tint="@color/obsidian_text_primary" />

                    <TextView
                        android:id="@+id/tvFavoriteText"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_favorite"
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMoreActions"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:contentDescription="@string/series_more_actions"
                    android:padding="13dp"
                    android:src="@drawable/ic_more_vert_24"
                    app:tint="@color/obsidian_text_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <!-- Seguir pasta e receber alertas de episódios -->
                <LinearLayout
                    android:id="@+id/btnFollow"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivFollowIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notification_24"
                        app:tint="@color/obsidian_text_primary" />

                    <TextView
                        android:id="@+id/tvFollowText"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_follow"
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

                <!-- Marcar como Assistido -->
                <LinearLayout
                    android:id="@+id/btnMarkWatched"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivMarkWatchedIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_cyan_circle" />

                    <TextView
                        android:id="@+id/tvMarkWatchedText"
                        style="@style/TextAppearance.Makimono.TV.Callout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/series_action_mark_watched"
                        android:textColor="@color/obsidian_text_primary" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

        <!-- 6. Season Navigation Tabs (Horizontal RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSeasonTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroContentBlock"
            tools:itemCount="6"
            tools:listitem="@layout/item_series_season_tab" />

        <TextView
            android:id="@+id/tvPartialListingNotice"
            style="@style/TextAppearance.Makimono.TV.Callout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="8dp"
            android:text="@string/series_partial_listing_notice"
            android:textColor="@color/obsidian_text_secondary"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvSeasonTabs" />

        <!-- 7. Episodes Horizontal Rail (16:9 Cards) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPartialListingNotice"
            tools:itemCount="6"
            tools:listitem="@layout/item_series_episode_card" />

        <!-- Empty state or Loading spinner / Shimmer skeleton -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/obsidian_accent_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone" />

        <include
            android:id="@+id/seriesSkeleton"
            layout="@layout/component_skeleton_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvSeasonTabs" />

        <zechs.drive.stream.ui.common.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvSeasonTabs" />

        <TextView
            android:id="@+id/tvEmptyEpisodes"
            style="@style/TextAppearance.Makimono.TV.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/series_empty_category"
            android:textColor="@color/obsidian_text_secondary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvSeasonTabs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/series_retry"
            android:textColor="?attr/colorTextPrimary"
            android:visibility="gone"
            app:backgroundTint="?attr/colorBgSurface"
            app:cornerRadius="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyEpisodes"
            app:strokeColor="?attr/colorAccentPrimary"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
