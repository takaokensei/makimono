<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <!-- 1. Hero Backdrop Image (Subtle ambient layer) -->
        <ImageView
            android:id="@+id/ivHeroBackdrop"
            android:layout_width="0dp"
            android:layout_height="480dp"
            android:alpha="0.22"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/bg_anime_library" />

        <!-- Dynamic Tint Gradient Overlay for coverImage.color -->
        <View
            android:id="@+id/viewDynamicColorTint"
            android:layout_width="0dp"
            android:layout_height="480dp"
            android:background="@drawable/series_detail_hero_scrim"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 2. Bottom Scrim Gradient (Transparent -> #0B0E14) -->
        <View
            android:id="@+id/viewHeroScrim"
            android:layout_width="0dp"
            android:layout_height="320dp"
            android:background="@drawable/series_detail_hero_scrim"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 3. Left Vignette Gradient (#F20B0E14 -> Transparent) -->
        <View
            android:id="@+id/viewHeroVignette"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/series_detail_vignette"
            app:layout_constraintBottom_toBottomOf="@id/ivHeroBackdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 4. Top Header Bar -->
        <LinearLayout
            android:id="@+id/topHeaderBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="28dp"
            android:paddingEnd="40dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_secondary_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_back_24"
                    app:tint="#F8FAFC" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Breadcrumbs: Animes › Séries -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBreadcrumbRoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Animes"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="›"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvBreadcrumbCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Séries"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- Search Button -->
            <FrameLayout
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_secondary_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search_24"
                    app:tint="#F8FAFC" />
            </FrameLayout>

        </LinearLayout>

        <!-- 5. Hero Card Variant Container (Sharp 2:3 Poster Card on Left + Content on Right) -->
        <LinearLayout
            android:id="@+id/heroContentBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topHeaderBar">

            <!-- Hero Poster Card (Sharp 2:3 Portrait Poster) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeriesPoster"
                android:layout_width="190dp"
                android:layout_height="285dp"
                android:clickable="false"
                android:focusable="false"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:strokeColor="#3338BDF8"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/ivSeriesPosterCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/kodi_primary_bg" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Text Details & Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- Japanese Kanji Title -->
            <TextView
                android:id="@+id/tvJapaneseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:visibility="gone"
                tools:text="グリザイアの楽園"
                tools:visibility="visible" />

            <!-- Main Romaji / Canonical Title -->
            <TextView
                android:id="@+id/tvRomajiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                tools:text="Grisaia no Rakuen" />

            <!-- Subtitle / English Title -->
            <TextView
                android:id="@+id/tvEnglishSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                tools:text="THE EDEN OF GRISAIA" />

            <!-- Meta Row 1: Age Rating | Year | Status | MAL Rating -->
            <LinearLayout
                android:id="@+id/metaRow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAgeRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_age_rating_bg"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="16+" />

                <TextView
                    android:id="@+id/tvReleaseYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    tools:text="2015" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="|"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSeriesStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    tools:text="Completo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="|"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <!-- Rating pill -->
                <LinearLayout
                    android:id="@+id/layoutRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_filled_24"
                        app:tint="#FBBF24" />

                    <TextView
                        android:id="@+id/tvMalScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        tools:text="8.2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:text="MAL" />
                </LinearLayout>

            </LinearLayout>

            <!-- Meta Row 2: Tech Specs (1080p, Dual Audio, Multi Subs) -->
            <LinearLayout
                android:id="@+id/metaRow2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1080p -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_player_24"
                        app:tint="#94A3B8" />

                    <TextView
                        android:id="@+id/tvQualityBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="1080p"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Dual Áudio -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_audio_24"
                        app:tint="#94A3B8" />

                    <TextView
                        android:id="@+id/tvAudioTrackBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Dual Áudio PT-BR / JA"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Multi Subs -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_meta_pill_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_subtitles_24"
                        app:tint="#94A3B8" />

                    <TextView
                        android:id="@+id/tvSubtitleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Multi Subs"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Synopsis -->
            <TextView
                android:id="@+id/tvSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="#94A3B8"
                android:textSize="12.5sp"
                tools:text="Após ser atacada por um vampiro e sobreviver, Koyomi Araragi se vê envolvido com diversas garotas ligadas a excentricidades sobrenaturais..." />

            <!-- Actions Row: Continue Watch / Play | Trailer | Favorite | Watched -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary Action Button (Play / Continue) -->
                <LinearLayout
                    android:id="@+id/btnPrimaryAction"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_primary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/ivPrimaryActionIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_24"
                        app:tint="#22D3EE" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPrimaryActionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:includeFontPadding="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            tools:text="Continuar Assistindo" />

                        <TextView
                            android:id="@+id/tvPrimaryActionSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            tools:text="Ep. 4 • 14:28 restante" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Ver Trailer -->
                <LinearLayout
                    android:id="@+id/btnTrailer"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trailer_24"
                        app:tint="#E2E8F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Ver Trailer"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Favoritar -->
                <LinearLayout
                    android:id="@+id/btnFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivFavoriteIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star_outline_24"
                        app:tint="#E2E8F0" />

                    <TextView
                        android:id="@+id/tvFavoriteText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Favoritar"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Marcar como Assistido -->
                <LinearLayout
                    android:id="@+id/btnMarkWatched"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_secondary_action_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivMarkWatchedIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_cyan_circle" />

                    <TextView
                        android:id="@+id/tvMarkWatchedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Marcar como Assistido"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

        <!-- 6. Season Navigation Tabs (Horizontal RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSeasonTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroContentBlock"
            tools:itemCount="6"
            tools:listitem="@layout/item_series_season_tab" />

        <!-- 7. Episodes Horizontal Rail (16:9 Cards) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvSeasonTabs"
            tools:itemCount="6"
            tools:listitem="@layout/item_series_episode_card" />

        <!-- Empty state or Loading spinner -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#22D3EE"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvEmptyEpisodes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="Nenhum episódio encontrado nesta categoria."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvSeasonTabs" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
