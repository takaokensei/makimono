<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardKodiPanelRoot"
    android:layout_width="660dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/obsidian_media_scrim"
    app:cardCornerRadius="20dp"
    app:cardElevation="24dp"
    app:strokeColor="?attr/colorBorderGlass"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:background="?attr/colorAccentPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPanelTitle"
                    style="@style/TextAppearance.Makimono.TV.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold"
                    tools:text="Legendas" />

                <TextView
                    android:id="@+id/tvPanelSubtitle"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/obsidian_text_secondary"
                    tools:text="Faixas embutidas e sincronização em tempo real" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnPanelClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/content_description_close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/obsidian_text_secondary" />

        </LinearLayout>

        <!-- Segmented Kodi/VLC Tabs -->
        <LinearLayout
            android:id="@+id/layoutTabsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabTracks"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kodi_tab_pill"
                android:fontFamily="@font/inter"
                android:text="@string/kodi_tab_tracks"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="@color/obsidian_text_primary"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSync"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kodi_tab_pill"
                android:fontFamily="@font/inter"
                android:text="@string/kodi_tab_sync"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="@color/obsidian_text_secondary"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kodi_tab_pill"
                android:fontFamily="@font/inter"
                android:text="@string/kodi_tab_appearance"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="@color/obsidian_text_secondary"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabOnline"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kodi_tab_pill"
                android:fontFamily="@font/inter"
                android:text="@string/kodi_tab_online"
                android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                android:textColor="@color/obsidian_text_secondary"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@null"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Dynamic Content Pages -->
        <FrameLayout
            android:id="@+id/containerPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- PAGE 1: TRACKS LIST -->
            <LinearLayout
                android:id="@+id/pageTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPanelTracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:maxHeight="320dp"
                    android:nestedScrollingEnabled="true"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_player_glass_menu" />

            </LinearLayout>

            <!-- PAGE 2: LIVE SYNC STEPPER (Kodi & VLC Style) -->
            <LinearLayout
                android:id="@+id/pageSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Offset Display -->
                <TextView
                    android:id="@+id/tvSyncOffset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="?attr/colorAccentPrimary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="+0.00 s" />

                <TextView
                    android:id="@+id/tvSyncHint"
                    style="@style/TextAppearance.Makimono.TV.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/kodi_sync_hint"
                    android:textColor="@color/obsidian_text_secondary" />

                <!-- Fine Stepper Row (-100ms / 0ms / +100ms) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncMinusFine"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="- 100 ms"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncReset"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sync_reset"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                        android:textColor="?attr/colorAccentPrimary"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncPlusFine"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="+ 100 ms"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Body"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- Coarse Stepper Row (-500ms / +500ms) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncMinusCoarse"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="- 500 ms"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_secondary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncPlusCoarse"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="+ 500 ms"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_secondary"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- PAGE 3: SUBTITLE APPEARANCE (VLC Style) -->
            <LinearLayout
                android:id="@+id/pageSubtitleSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Text Size -->
                <TextView
                    style="@style/TextAppearance.Makimono.TV.Subheadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/kodi_sub_size_title"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize16"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_size_16"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize20"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_size_20"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize24"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_size_24"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSize28"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_size_28"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- Subtitle Color -->
                <TextView
                    style="@style/TextAppearance.Makimono.TV.Subheadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/kodi_sub_color_title"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnColorWhite"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_color_white"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnColorYellow"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_color_yellow"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/kodi_subtitle_yellow"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnColorCyan"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="@string/kodi_sub_color_cyan"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="?attr/colorAccentPrimary"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- PAGE 4: AUDIO PROCESSING & NIGHT MODE (Kodi Style) -->
            <LinearLayout
                android:id="@+id/pageAudioSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Night Mode Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/obsidian_surface"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/obsidian_border_glass"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Makimono.TV.Subheadline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="@string/kodi_night_mode_title"
                                android:textColor="@color/obsidian_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.Makimono.TV.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter"
                                android:text="@string/kodi_night_mode_desc"
                                android:textColor="@color/obsidian_text_secondary" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleNightMode"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/bg_kodi_stepper_button"
                            android:fontFamily="@font/inter"
                            android:text="@string/kodi_night_mode_disabled"
                            android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Audio Boost -->
                <TextView
                    style="@style/TextAppearance.Makimono.TV.Subheadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/kodi_audio_boost_title"
                    android:textColor="@color/obsidian_text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBoost0"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="0 dB"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBoost4"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="+4 dB"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBoost8"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="+8 dB"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBoost12"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kodi_stepper_button"
                        android:fontFamily="@font/inter"
                        android:text="+12 dB"
                        android:textAppearance="@style/TextAppearance.Makimono.TV.Caption"
                        android:textColor="@color/obsidian_text_primary"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- PAGE 5: ONLINE SUBTITLES -->
            <LinearLayout
                android:id="@+id/pageOnlineSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pbOnlineSubtitles"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="?attr/colorAccentPrimary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOnlineTracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:maxHeight="320dp"
                    android:nestedScrollingEnabled="true"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_player_glass_menu" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
