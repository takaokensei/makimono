<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/cardProfileRoot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginHorizontal="@dimen/profile_card_margin_horizontal" android:layout_marginVertical="@dimen/profile_card_margin_vertical" android:clipChildren="false" android:clipToPadding="false" android:focusable="true" android:focusableInTouchMode="true" android:gravity="center_horizontal" android:orientation="vertical" android:padding="0dp" android:background="@android:color/transparent">
    <FrameLayout android:id="@+id/avatarContainer" android:layout_width="@dimen/profile_avatar_size" android:layout_height="@dimen/profile_avatar_size" android:background="@drawable/item_profile_avatar_ring" android:padding="1dp">
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProfileAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Makimono.Profile" tools:src="@drawable/avatar_caua" />
        <ImageView android:id="@+id/ivAddIcon" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:src="@drawable/ic_add_24" android:visibility="gone" app:tint="@color/obsidian_accent_primary" />
        <View android:id="@+id/badgeStatusTick" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="bottom|end" android:layout_margin="8dp" android:background="@drawable/glass_circle_button_bg" android:backgroundTint="@color/obsidian_warning" android:visibility="gone" />
        <ImageView android:id="@+id/ivEditBadge" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|end" android:layout_margin="2dp" android:background="@drawable/glass_circle_button_bg" android:backgroundTint="@color/obsidian_media_scrim" android:padding="4dp" android:src="@drawable/ic_edit_24" android:visibility="gone" app:tint="@color/obsidian_accent_primary" />
    </FrameLayout>
    <TextView android:id="@+id/tvProfileName" style="@style/TextAppearance.Makimono.TV.Body" android:layout_width="@dimen/profile_name_width" android:layout_height="wrap_content" android:minHeight="24dp" android:layout_marginTop="6dp" android:fontFamily="@font/inter" android:gravity="center" android:maxWidth="@dimen/profile_name_width" android:maxLines="2" android:textColor="@color/obsidian_text_primary" android:textStyle="normal" tools:text="Cauã" android:ellipsize="end" />
    <TextView android:id="@+id/tvProfileRole" style="@style/TextAppearance.Makimono.TV.Badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="20dp" android:textColor="@color/obsidian_accent_primary" android:layout_marginTop="0dp" android:visibility="gone" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/bg_glass_pill" />
</LinearLayout>
