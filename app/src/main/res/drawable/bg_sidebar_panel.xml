<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#FF05080D"
                android:endColor="#F2070A10" />
        </shape>
    </item>
    <!-- Right hairline divider -->
    <item android:left="-2dp" android:top="-2dp" android:bottom="-2dp">
        <shape>
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
