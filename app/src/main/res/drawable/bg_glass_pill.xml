<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorFocusFill" />
            <corners android:radius="8dp" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorAccentPrimary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorFocusFill" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorAccentPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swiss_glass_rail_collapsed" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/swiss_border_specular_subtle" />
        </shape>
    </item>
</selector>
