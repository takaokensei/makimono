<?xml version="1.0" encoding="utf-8"?>
<!--
    Kodi Estuary-style scrim: the preview photo sits underneath, this sits on
    top of it so tvShelfItemTitle / progress stay legible regardless of how
    bright the thumbnail frame is.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:centerColor="#80000000"
        android:endColor="#F0000000" />
</shape>
