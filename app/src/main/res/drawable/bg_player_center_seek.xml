<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#4D22D3EE" />
            <stroke android:width="2dp" android:color="#22D3EE" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#CC171717" />
            <stroke android:width="1.5dp" android:color="#22D3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#99171717" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
