<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: solid white pill + soft halo -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#26FFFFFF"/>
                    <corners android:radius="26dp"/>
                    <stroke android:width="4dp" android:color="#59FFFFFF"/>
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#FFFFFFFF"/>
                    <corners android:radius="24dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#D5DBE3"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <!-- Normal: slightly translucent white so the focus state reads clearly -->
    <item>
        <shape>
            <solid android:color="#F2FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</selector>
