<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBgSurface" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorAccentPrimary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBgSurface" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorAccentPrimary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBgGlass" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorBorderGlass" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>