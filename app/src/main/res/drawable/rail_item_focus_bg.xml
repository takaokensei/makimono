<?xml version="1.0" encoding="utf-8"?>
<!--
    Kodi Estuary's left-rail selection is a solid rectangular "pill" in the
    accent color, not the glass/outline treatment used by the destination
    grid cards (glass_card_bg.xml). Kept as its own drawable rather than a
    variant of glass_card_bg so the two visual languages (grid vs rail) don't
    fight each other if one is restyled later.
-->
<selector xmlns:android="http://schemas.android.com/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentPrimary" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentPrimary" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBgGlass" />
            <stroke android:width="1dp" android:color="?attr/colorAccentPrimary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
