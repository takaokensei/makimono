<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#2000E5FF"/>
                    <corners android:radius="12dp"/>
                    <stroke android:width="3dp" android:color="#6600E5FF"/>
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape>
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="11dp"/>
                    <stroke android:width="2dp" android:color="#FFFFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3300E5FF"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1.5dp" android:color="#00E5FF"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
