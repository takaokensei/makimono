<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Soft ambient glow -->
            <item>
                <shape>
                    <solid android:color="#14FFFFFF"/>
                    <corners android:radius="12dp"/>
                    <stroke android:width="4dp" android:color="#33FFFFFF"/>
                </shape>
            </item>
            <!-- Crisp white focus ring (Apple TV / Swiss Glass style) -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="11dp"/>
                    <stroke android:width="2.5dp" android:color="@color/swiss_focus_white"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#26FFFFFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
