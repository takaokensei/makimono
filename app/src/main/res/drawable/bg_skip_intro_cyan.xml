<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D22D3EE" />
            <stroke android:width="2dp" android:color="#22D3EE" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6171717" />
            <stroke android:width="1.5dp" android:color="#22D3EE" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3171717" />
            <stroke android:width="1dp" android:color="#6622D3EE" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
