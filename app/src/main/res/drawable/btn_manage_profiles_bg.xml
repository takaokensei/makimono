<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#4000C0FF" />
                    <corners android:radius="10dp" />
                    <stroke android:width="4dp" android:color="#8000C0FF" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#3300C0FF" />
                    <corners android:radius="8dp" />
                    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D00C0FF" />
            <stroke android:width="2dp" android:color="#00C0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <stroke android:width="1.5dp" android:color="#334155" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>