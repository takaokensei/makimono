<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: TV focus ring with glow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <stroke android:width="2dp" android:color="@color/obsidian_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Selected state: Lighter background, 1dp subtle border, NO GLOW (per specification) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2234" />
            <stroke android:width="1dp" android:color="#4D22D3EE" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default state: Subtle dark surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F141F" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
