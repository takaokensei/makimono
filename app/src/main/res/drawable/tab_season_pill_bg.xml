<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBgSurface" />
            <stroke android:width="1dp" android:color="?attr/colorBorderGlass" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorFocusFill" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBgGlass" />
            <stroke android:width="1dp" android:color="?attr/colorBorderGlass" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
