<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3322D3EE" />
            <stroke
                android:width="2.5dp"
                android:color="#FF22D3EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2622D3EE" />
            <stroke
                android:width="1.8dp"
                android:color="#FF22D3EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3322D3EE" />
            <stroke
                android:width="1.5dp"
                android:color="#9922D3EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141E293B" />
            <stroke
                android:width="1dp"
                android:color="#3394A3B8" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
