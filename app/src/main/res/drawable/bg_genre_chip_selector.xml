<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/obsidian_focus_fill" />
            <stroke android:width="2dp" android:color="?attr/colorAccentPrimary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentPrimary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/obsidian_bg_glass" />
            <stroke android:width="1dp" android:color="@color/obsidian_border_glass" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
