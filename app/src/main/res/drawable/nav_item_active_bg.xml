<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Apple tvOS / Swiss Pure Optical White Pill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/swiss_focus_white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Expanded & Active (unfocused): Frosted Glass Pill with Specular Border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/swiss_glass_regular" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/swiss_border_specular_bright" />
        </shape>
    </item>
    <!-- Collapsed & Active (unfocused): Subtle Translucent Glass Indicator -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swiss_glass_thin" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/swiss_border_specular_subtle" />
        </shape>
    </item>
</selector>
