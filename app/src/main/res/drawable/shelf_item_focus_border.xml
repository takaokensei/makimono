<?xml version="1.0" encoding="utf-8"?>
<!--
    D-pad focus ring for a photo-backed shelf card: a cyan outline with subtle overlay
    for better contrast and visibility on TV. rail_item_focus_bg is a solid fill made
    for the icon-only nav rail pills and would blot out the whole photo if reused here.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <shape android:shape="rectangle">
                <solid android:color="#33000000" />
                <corners android:radius="12dp" />
            </shape>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="4dp"
                    android:color="?attr/colorAccentPrimary" />
                <corners android:radius="12dp" />
            </shape>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <shape android:shape="rectangle">
                <solid android:color="#4D000000" />
                <corners android:radius="12dp" />
            </shape>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="4dp"
                    android:color="?attr/colorAccentPrimary" />
                <corners android:radius="12dp" />
            </shape>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
