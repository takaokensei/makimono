<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- 1. Outer luminous cyan halo (10-foot TV ambient glow) -->
            <item>
                <shape>
                    <solid android:color="#2000E5FF" />
                    <corners android:radius="12dp" />
                    <stroke android:width="4dp" android:color="#6600E5FF" />
                </shape>
            </item>
            <!-- 2. Inner crisp high-contrast border (sharp focus frame) -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="10dp" />
                    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3300E5FF" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>