<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#4000E5FF"/>
                    <corners android:radius="24dp"/>
                    <stroke android:width="3dp" android:color="#8000E5FF"/>
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape>
                    <solid android:color="#FFFFFFFF"/>
                    <corners android:radius="22dp"/>
                    <stroke android:width="1.5dp" android:color="#FFFFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E2E8F0"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</selector>
