<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorAccentPrimary"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/colorBgSurface"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="?attr/colorAccentPrimary"/>
        </shape>
    </item>
    <!-- Focus is drawn once by TvFocusRing using the active theme accent. -->
    <item>
        <shape>
            <solid android:color="?attr/colorAccentPrimary"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</selector>
