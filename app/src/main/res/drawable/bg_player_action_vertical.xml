<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><layer-list>
        <item><shape><solid android:color="#4000C0FF"/><corners android:radius="14dp"/><stroke android:width="4dp" android:color="#8000E5FF"/></shape></item>
        <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#3300C0FF"/><corners android:radius="12dp"/><stroke android:width="2dp" android:color="#FFFFFFFF"/></shape></item>
    </layer-list></item>
    <item android:state_pressed="true"><shape><solid android:color="#4032DFFF"/><corners android:radius="12dp"/></shape></item>
    <item><shape><solid android:color="@android:color/transparent"/><corners android:radius="12dp"/></shape></item>
</selector>