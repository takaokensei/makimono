<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Crisp luminous border with subtle frosted fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#40FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#35FFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Normal: Frosted glass pill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#20FFFFFF" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>