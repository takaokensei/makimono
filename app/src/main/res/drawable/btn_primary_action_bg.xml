<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3322D3EE" />
            <stroke
                android:width="2.5dp"
                android:color="#FF22D3EE" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D22D3EE" />
            <stroke
                android:width="2dp"
                android:color="#FF22D3EE" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A162B3A" />
            <stroke
                android:width="1.5dp"
                android:color="#9922D3EE" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
