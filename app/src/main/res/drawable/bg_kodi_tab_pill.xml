<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected / Checked State -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/obsidian_bg_glass" />
            <stroke android:width="1.5dp" android:color="?attr/colorAccentPrimary" />
        </shape>
    </item>
    <!-- Focused (D-Pad navigation) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/obsidian_surface" />
            <stroke android:width="2dp" android:color="?attr/colorAccentPrimary" />
        </shape>
    </item>
    <!-- Default Unselected -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/obsidian_bg_surface" />
            <stroke android:width="1dp" android:color="@color/obsidian_border_glass" />
        </shape>
    </item>
</selector>
