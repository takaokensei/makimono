<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#2000E5FF" />
                    <corners android:radius="16dp" />
                    <stroke android:width="4dp" android:color="#6600E5FF" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#E60A192F" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#E60A192F" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#B308172A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#315471" />
        </shape>
    </item>
</selector>
