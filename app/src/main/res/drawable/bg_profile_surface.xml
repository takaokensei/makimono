<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#14FFFFFF" />
                    <corners android:radius="14dp" />
                    <stroke android:width="4dp" android:color="#33FFFFFF" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#26FFFFFF" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#22D3EE" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
