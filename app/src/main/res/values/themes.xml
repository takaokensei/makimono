        <item name="colorStatusDanger">@color/mocha_danger</item>

        <item name="android:statusBarColor">@color/mocha_bg_base</item>
        <item name="android:navigationBarColor">@color/mocha_bg_base</item>
        <item name="android:windowBackground">@color/mocha_bg_base</item>
        <item name="colorSurface">@color/mocha_bg_surface</item>
        <item name="colorOnSurface">@color/mocha_text_primary</item>
        <item name="colorPrimary">@color/mocha_accent_primary</item>
        <item name="colorSecondary">@color/mocha_accent_secondary</item>
    </style>

    <!-- Theme 5: Kodi Estuary (petroleum/cyan, see docs/kodi_reference) -->
    <style name="Theme.DriveStream.KodiEstuary" parent="Theme.DriveStream.Base">
        <item name="colorBgBase">@color/estuary_bg_base</item>
        <item name="colorBgSurface">@color/estuary_bg_surface</item>
        <item name="colorBgGlass">@color/estuary_bg_glass</item>
        <item name="colorBorderGlass">@color/estuary_border_glass</item>
        <item name="colorTextPrimary">@color/estuary_text_primary</item>
        <item name="colorTextSecondary">@color/estuary_text_secondary</item>
        <item name="colorAccentPrimary">@color/estuary_accent_primary</item>
        <item name="colorAccentSecondary">@color/estuary_accent_secondary</item>
        <item name="colorStatusSuccess">@color/estuary_success</item>
        <item name="colorStatusWarning">@color/estuary_warning</item>
        <item name="colorStatusDanger">@color/estuary_danger</item>

        <item name="android:statusBarColor">@color/estuary_bg_base</item>
        <item name="android:navigationBarColor">@color/estuary_bg_base</item>
        <item name="android:windowBackground">@color/estuary_bg_base</item>
        <item name="colorSurface">@color/estuary_bg_surface</item>
        <item name="colorOnSurface">@color/estuary_text_primary</item>
        <item name="colorPrimary">@color/estuary_accent_primary</item>
        <item name="colorSecondary">@color/estuary_accent_secondary</item>
    </style>

    <!-- Legacy alias to TokyoNight -->
    <style name="AppTheme" parent="Theme.DriveStream.TokyoNight" />

    <!-- Fullscreen Player Themes inheriting Semantic Tokens -->
    <style name="Theme.Fullscreen" parent="Theme.DriveStream.TokyoNight">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Fullscreen.TokyoNight" parent="Theme.DriveStream.TokyoNight">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Fullscreen.Dracula" parent="Theme.DriveStream.Dracula">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Fullscreen.Nord" parent="Theme.DriveStream.Nord">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Fullscreen.CatppuccinMocha" parent="Theme.DriveStream.CatppuccinMocha">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Fullscreen.KodiEstuary" parent="Theme.DriveStream.KodiEstuary">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="MenuTheme" parent="@style/Widget.Material3.ActionBar.Solid">
        <item name="android:textColorSecondary">?attr/colorTextSecondary</item>
        <item name="android:actionMenuTextColor">?attr/colorTextPrimary</item>
        <item name="android:backgroundTint">?attr/colorBgSurface</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="colorControlNormal">?attr/colorTextPrimary</item>
        <item name="selectableItemBackground">?android:selectableItemBackground</item>
        <item name="colorControlHighlight">?attr/colorAccentPrimary</item>
        <item name="selectableItemBackgroundBorderless">?android:selectableItemBackground</item>
    </style>

    <style name="titleTextAppearance" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="subtitleTextAppearance" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">?attr/colorTextSecondary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="IconButtonTheme" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">?attr/colorAccentPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorBorderGlass</item>
    </style>

    <style name="Widget.Material3.Button.TonalButton.Icon.Only" parent="Widget.Material3.Button.IconButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button.TonalButton</item>
    </style>

    <!-- Shape for Glass Dialogs -->
    <style name="ShapeAppearance.DriveStream.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Unified Glass / Theme Dialog Overlay for Audio, Subtitle, Speed and Chapters -->
    <style name="ThemeOverlay.DriveStream.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/colorBgSurface</item>
        <item name="colorOnSurface">?attr/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/colorTextSecondary</item>
        <item name="colorPrimary">?attr/colorAccentPrimary</item>
        <item name="colorSecondary">?attr/colorAccentSecondary</item>
        <item name="colorControlActivated">?attr/colorAccentPrimary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DriveStream.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DriveStream.Dialog.Body</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DriveStream.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/DriveStream.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/DriveStream.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/DriveStream.Dialog.Button</item>
    </style>

    <style name="DriveStream.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DriveStream.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DriveStream.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorAccentPrimary</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>