<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Base da Aplicação -->
    <style name="Theme.IntelligentMendel" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores Primárias -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <!-- Cores Secundárias -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <!-- Cores Terciárias -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <!-- Cores Neutras -->
        <item name="colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>

        <!-- Tipografia -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.IntelligentMendel.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.IntelligentMendel.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.IntelligentMendel.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.IntelligentMendel.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.IntelligentMendel.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.IntelligentMendel.Headline6</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.IntelligentMendel.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.IntelligentMendel.BodyMedium</item
        <item name="textAppearanceBodySmall">@style/TextAppearance.IntelligentMendel.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.IntelligentMendel.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.IntelligentMendel.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.IntelligentMendel.LabelSmall</item>

        <!-- Formas -->
        <item name="shapeCornerSmall">@dimen/shapeCornerSmall</item>
        <item name="shapeCornerMedium">@dimen/shapeCornerMedium</item>
        <item name="shapeCornerLarge">@dimen/shapeCornerLarge</item>
        <item name="shapeCornerFamily">rounded</item>

        <!-- Elevação -->
        <item name="elevationLevel0">0dp</item>
        <item name="elevationLevel1">1dp</item>
        <item name="elevationLevel2">2dp</item>
        <item name="elevationLevel3">4dp</item>
        <item name="elevationLevel4">6dp</item>
        <item name="elevationLevel5">8dp</item>

        <!-- Sobrescrita de Componentes -->
        <item name="materialButtonStyle">@style/Widget.IntelligentMendel.Button</item>
        <item name="textInputStyle">@style/Widget.IntelligentMendel.TextInputLayout</item>
        <item name="checkboxStyle">@style/Widget.IntelligentMendel.Checkbox</item>
        <item name="radioButtonStyle">@style/Widget.IntelligentMendel.RadioButton</item>
        <item name="switchStyle">@style/Widget.IntelligentMendel.Switch</item>
    </style>

    <!-- Estilos de Tipografia -->
    <style name="TextAppearance.IntelligentMendel.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/display_line_height</item>
        <item name="android:letterSpacing">0.5</item>
    </style>

    <style name="TextAppearance.IntelligentMendel.Headline2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.IntelligentMendel.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item