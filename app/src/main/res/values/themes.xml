<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveStream.TokyoNight</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
    </style>

    <!-- Base DriveStream Theme with Inter Typography -->
    <style name="Theme.DriveStream.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DriveStream.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.DriveStream.Dialog</item>
    </style>

    <!-- Theme 1: Tokyo Night (Default) -->
    <style name="Theme.DriveStream.TokyoNight" parent="Theme.DriveStream.Base">
        <item name="colorBgBase">@color/tn_bg_base</item>
        <item name="colorBgSurface">@color/tn_bg_surface</item>
        <item name="colorBgGlass">@color/tn_bg_glass</item>
        <item name="colorBorderGlass">@color/tn_border_glass</item>
        <item name="colorTextPrimary">@color/tn_text_primary</item>
        <item name="colorTextSecondary">@color/tn_text_secondary</item>
        <item name="colorAccentPrimary">@color/tn_accent_primary</item>
        <item name="colorAccentSecondary">@color/tn_accent_secondary</item>
        <item name="colorStatusSuccess">@color/tn_success</item>
        <item name="colorStatusWarning">@color/tn_warning</item>
        <item name="colorStatusDanger">@color/tn_danger</item>

        <item name="android:statusBarColor">@color/tn_bg_base</item>
        <item name="android:navigationBarColor">@color/tn_bg_base</item>
        <item name="android:windowBackground">@color/tn_bg_base</item>
        <item name="colorSurface">@color/tn_bg_surface</item>
        <item name="colorOnSurface">@color/tn_text_primary</item>
        <item name="colorPrimary">@color/tn_accent_primary</item>
        <item name="colorSecondary">@color/tn_accent_secondary</item>
    </style>

    <!-- Theme 2: Dracula ("Vampire") -->
    <style name="Theme.DriveStream.Dracula" parent="Theme.DriveStream.Base">
        <item name="colorBgBase">@color/dracula_bg_base</item>
        <item name="colorBgSurface">@color/dracula_bg_surface</item>
        <item name="colorBgGlass">@color/dracula_bg_glass</item>
        <item name="colorBorderGlass">@color/dracula_border_glass</item>
        <item name="colorTextPrimary">@color/dracula_text_primary</item>
        <item name="colorTextSecondary">@color/dracula_text_secondary</item>
        <item name="colorAccentPrimary">@color/dracula_accent_primary</item>
        <item name="colorAccentSecondary">@color/dracula_accent_secondary</item>
        <item name="colorStatusSuccess">@color/dracula_success</item>
        <item name="colorStatusWarning">@color/dracula_warning</item>
        <item name="colorStatusDanger">@color/dracula_danger</item>

        <item name="android:statusBarColor">@color/dracula_bg_base</item>
        <item name="android:navigationBarColor">@color/dracula_bg_base</item>
        <item name="android:windowBackground">@color/dracula_bg_base</item>
        <item name="colorSurface">@color/dracula_bg_surface</item>
        <item name="colorOnSurface">@color/dracula_text_primary</item>
        <item name="colorPrimary">@color/dracula_accent_primary</item>
        <item name="colorSecondary">@color/dracula_accent_secondary</item>
    </style>

    <!-- Theme 3: Nord (Scandinavian Minimalism) -->
    <style name="Theme.DriveStream.Nord" parent="Theme.DriveStream.Base">
        <item name="colorBgBase">@color/nord_bg_base</item>
        <item name="colorBgSurface">@color/nord_bg_surface</item>
        <item name="colorBgGlass">@color/nord_bg_glass</item>
        <item name="colorBorderGlass">@color/nord_border_glass</item>
        <item name="colorTextPrimary">@color/nord_text_primary</item>
        <item name="colorTextSecondary">@color/nord_text_secondary</item>
        <item name="colorAccentPrimary">@color/nord_accent_primary</item>
        <item name="colorAccentSecondary">@color/nord_accent_secondary</item>
        <item name="colorStatusSuccess">@color/nord_success</item>
        <item name="colorStatusWarning">@color/nord_warning</item>
        <item name="colorStatusDanger">@color/nord_danger</item>

        <item name="android:statusBarColor">@color/nord_bg_base</item>
        <item name="android:navigationBarColor">@color/nord_bg_base</item>
        <item name="android:windowBackground">@color/nord_bg_base</item>
        <item name="colorSurface">@color/nord_bg_surface</item>
        <item name="colorOnSurface">@color/nord_text_primary</item>
        <item name="colorPrimary">@color/nord_accent_primary</item>
        <item name="colorSecondary">@color/nord_accent_secondary</item>
    </style>

    <!-- Theme 4: Catppuccin Mocha -->
    <style name="Theme.DriveStream.CatppuccinMocha" parent="Theme.DriveStream.Base">
        <item name="colorBgBase">@color/mocha_bg_base</item>
        <item name="colorBgSurface">@color/mocha_bg_surface</item>
        <item name="colorBgGlass">@color/mocha_bg_glass</item>
        <item name="colorBorderGlass">@color/mocha_border_glass</item>
