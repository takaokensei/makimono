<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Google TV / Android TV guidelines (and most consumer TV panels still sold today)
        recommend keeping interactive and text content at least 5% inset from each edge
        to survive overscan cropping. Keep content 48dp horizontally and 30dp vertically.
        We centralize it here so every TV-facing screen stays consistent and the margin
        TV-facing screen stays consistent and the margin can be tuned in one place.
    -->
    <dimen name="tv_overscan_margin">48dp</dimen>
    <dimen name="tv_overscan_margin_vertical">30dp</dimen>
    <dimen name="tv_nav_rail_width">240dp</dimen>
    <dimen name="tv_nav_item_height">56dp</dimen>
    <dimen name="tv_nav_icon_size">32dp</dimen>
    <dimen name="tv_shelf_card_width">260dp</dimen>
    <dimen name="tv_shelf_card_height">146dp</dimen>

    <!-- Home "streaming" layout: cinematic hero + generous side gutter -->
    <dimen name="home_hero_height">384dp</dimen>
    <dimen name="home_hero_action_height">48dp</dimen>
    <dimen name="home_content_margin">48dp</dimen>
    <dimen name="home_shelf_height">152dp</dimen>

    <!-- Profile Selection (Default / Phone portrait) -->
    <dimen name="profile_avatar_size">104dp</dimen>
    <dimen name="profile_card_margin_horizontal">10dp</dimen>
    <dimen name="profile_card_margin_vertical">10dp</dimen>
    <dimen name="profile_title_size">26sp</dimen>

    <!-- Player UI -->
    <dimen name="next_episode_card_offset">84dp</dimen>

    <!-- Accessibility Improvements (A11Y-01) -->
    <!-- Minimum touch targets (Android / WCAG 2.1 AA minimum 48x48dp) -->
    <dimen name="touch_target_min_size">48dp</dimen>
    <dimen name="icon_size_small">20dp</dimen>
    <dimen name="icon_size_medium">24dp</dimen>
    <dimen name="icon_size_large">32dp</dimen>

    <!-- Text scaling -->
    <dimen name="text_size_body">16sp</dimen>
    <dimen name="text_size_title">20sp</dimen>
    <dimen name="text_size_header">24sp</dimen>

    <!-- Design System Spacing (4dp grid system) -->
    <dimen name="spacing_0">0dp</dimen>
    <dimen name="spacing_1">4dp</dimen>
    <dimen name="spacing_2">8dp</dimen>
    <dimen name="spacing_3">12dp</dimen>
    <dimen name="spacing_4">16dp</dimen>
    <dimen name="spacing_5">20dp</dimen>
    <dimen name="spacing_6">24dp</dimen>
    <dimen name="spacing_8">32dp</dimen>
    <dimen name="spacing_12">48dp</dimen>
    <dimen name="spacing_16">64dp</dimen>

    <!-- Obsidian shape and elevation tokens -->
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_dialog">28dp</dimen>
    <dimen name="radius_hud">32dp</dimen>
    <dimen name="elevation_card_resting">2dp</dimen>
    <dimen name="elevation_focus">12dp</dimen>
    <dimen name="elevation_overlay">24dp</dimen>

    <!-- Standard screen padding -->
    <dimen name="content_padding">@dimen/spacing_4</dimen>
    <dimen name="horizontal_padding">@dimen/spacing_4</dimen>
    <dimen name="vertical_padding">@dimen/spacing_3</dimen>
</resources>
