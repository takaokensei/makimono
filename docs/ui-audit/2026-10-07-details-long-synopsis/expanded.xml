content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[707,181][743,209]" /><node index="2" text="MAL" resource-id="" class="android.widget.TextView" package="zechs.drive.stream.visualreview" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[750,182][796,207]" /></node></node><node index="3" text="Após a derrota do Rei Demônio, a elfa Frieren parte em uma jornada que atravessa décadas para compreender melhor as pessoas que fizeram parte de sua vida. Ao lado de Fern e Stark, ela revisita lugares conhecidos, encontra novos companheiros e descobre que pequenos momentos podem guardar um significado profundo. Entre ruínas, vilarejos e caminhos esquecidos, cada encontro revela uma lembrança diferente e muda a forma como Frieren enxerga o tempo, a amizade e as despedidas. Esta prévia longa verifica a expansão da sinopse sem esconder os controles principais nem prender o foco fora da área visível." resource-id="zechs.drive.stream.visualreview:id/tvSynopsis" class="android.widget.TextView" package="zechs.drive.stream.visualreview" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[357,230][1162,636]" /><node index="4" text="Recolher sinopse" resource-id="zechs.drive.stream.visualreview:id/tvSynopsisMore" class="android.widget.TextView" package="zechs.drive.stream.visualreview" content-desc="Recolher sinopse" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="true" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[357,636][576,720]" /></node></node></node></no