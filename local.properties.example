sdk.dir=C:\\Users\\AppData\\Local\\Android\\Sdk
drive.clientId=YOUR_GOOGLE_DRIVE_CLIENT_ID
drive.clientSecret=YOUR_GOOGLE_DRIVE_CLIENT_SECRET
drive.refreshToken=YOUR_GOOGLE_DRIVE_REFRESH_TOKEN
mal.clientId=YOUR_MAL_CLIENT_ID
mal.clientSecret=YOUR_MAL_CLIENT_SECRET
# Personal GitHub token with read-only access to the private repository releases.
# This value is packaged into this single-user APK and must never be committed.
github.apiToken=YOUR_GITHUB_READ_ONLY_TOKEN
